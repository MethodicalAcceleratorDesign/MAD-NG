-- Simple tooltox --------------------------------------------------------------

local twiss, plot in MAD

local tbox = {}

-- Start of tooltox ------------------------------------------------------------

!! columns
-- Minimal set of survey columns for flat machine.
tbox.sv_cols = {"name","s","l","x","z","theta"}
-- Minimal set of track columns for multi-turns tracking.
tbox.tk_cols = {"name","x","px","y","py","t","pt","id","turn"}
-- Minimal set of twiss columns for transverse optics.
tbox.tw_cols = {"name","s","l","beta11","beta22","mu1","mu2","dx","dy"}
!! end

!! twiss_4plot
-- Template for oversampled twiss data to produce a smooth plot.
tbox.twiss_4plot = twiss {
  nslice=10, implicit=true, save='atstd',            -- for smooth plot
  exec = false,                                      -- template, no exec
}
!! end

-- Note: LaTeX version is in toolbox_tex.mad
!! plot_twiss
-- Template for plotting optical functions.
tbox.plot_twiss = plot {
  x1y1    = {s = {"beta11", "beta22", "dx", "dy"}}, -- x vs y1 columns
  x1y2    = {s = {"mu1", "mu2"}},                   -- x vs y2 columns
  xlabel  = "s [m]"   ,                             -- x-axis label
  ylabel  = "β_{x,y} [m], D_{x,y} [m]",             -- y-axis label left
  y2label = "μ_{x,y} [rad/2π]",                     -- y-axis label right
  legend  = {beta11="β_x", beta22="β_y",            -- column labels
             mu1="μ_x", mu2="μ_y",                   --   idem
             dx="D_x", dy="D_y"},                    --   idem
  styles  = "lines", linewidth=1.5, fontsize=16,    -- styles
  exec    = false,                                  -- template, no exec
}

-- Template for plotting Montaigue functions.
tbox.plot_chrom = plot {
  x1y1    = {s = {"wx", "wy", "phix", "phiy"}},     -- x vs y1 columns
  xlabel  = "s [m]"   ,                             -- x-axis label
  ylabel  = "w_{x,y} , w_{x,y}p [m]",               -- y-axis label left
  legend  = {wx="w_x", wy="w_y",                    -- column labels
             phix="w_xp", phiy="w_yp"},             --   idem
  styles  = "lines", linewidth=1.5, fontsize=16,    -- styles
  exec    = false,                                  -- template, no exec
}
!! end

-- End of tooltox --------------------------------------------------------------
return tbox