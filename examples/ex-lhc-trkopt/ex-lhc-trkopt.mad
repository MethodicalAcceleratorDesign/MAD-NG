  title    = "wp vs da ("..snam..", order "..ord..")",  -- plot title
  sequence = seq,             -- sequence for layout
  table    = twp,             -- twiss table for plot
  x1y1     = {s = {"wxp_vs_dqx_da", "wxp_vs_dqy_da", "wyp_vs_dqx_da", "wyp_vs_dqy_da"}},
  xlabel   = "s [m]"   ,                             -- x-axis label
  ylabel   = "w_{x,y}p",                             -- y-axis label left
  legend   = {wxp_vs_dqx_da="wpx vs dqx", wxp_vs_dqy_da="wpx vs dqy",
              wyp_vs_dqx_da="wpy vs dqx", wyp_vs_dqy_da="wpy vs dqy"},
  styles   = "lines", linewidth=1.5, fontsize=16,    -- styles
  output   = fplt,
}

plot {
  title    = "wp vs fd ("..snam..", order "..ord..")",  -- plot title
  sequence = seq,             -- sequence for layout
  table    = twp,             -- twiss table for plot
  x1y1     = {s = {"wxp_vs_dqx_fd", "wxp_vs_dqy_fd", "wyp_vs_dqx_fd", "wyp_vs_dqy_fd"}},
  xlabel   = "s [m]"   ,                             -- x-axis labellabel
  ylabel   = "w_{x,y}p",                             -- y-axis label left
  legend   = {wxp_vs_dqx_fd="wxp vs dqx", wxp_vs_dqy_fd="wxp vs dqy",
              wyp_vs_dqx_fd="wyp vs dqx", wyp_vs_dqy_fd="wyp vs dqy"},
  styles   = "lines", linewidth=1.5, fontsize=16,    -- styles
  output   = fplt,
}

plot {
  title    = "wp vs da and fd diff ("..snam..", order "..ord..")",  -- plot title
  sequence = seq,             -- sequence for layout
  table    = twp,             -- twiss table for plot
  x1y1     = {s = {"wxp_vs_dqx_dif", "wxp_vs_dqy_dif", "wyp_vs_dqx_dif", "wyp_vs_dqy_dif"}},
  xlabel   = "s [m]"   ,                             -- x-axis label
  ylabel   = "Error on w_{x,y}p",                    -- y-axis label left
  legend   = {wxp_vs_dqx_dif="wxp vs dqx err", wxp_vs_dqy_dif="wxp vs dqy err",
              wyp_vs_dqx_dif="wyp vs dqx err", wyp_vs_dqy_dif="wyp vs dqy err"},
  styles   = "lines", linewidth=1.5, fontsize=16,    -- styles
  output   = fplt,
}
end -- chrm

end -- over order ord

end -- over seq
