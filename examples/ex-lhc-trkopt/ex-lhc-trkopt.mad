  twp:addcol("wxp_vs_dqy_dif"   , \ri -> twp.wxp_vs_dqy_da   [ri] - twp.wxp_vs_dqy_fd   [ri])
  twp:addcol("wy_vs_dqx_dif"    , \ri -> twp.wy_vs_dqx_da    [ri] - twp.wy_vs_dqx_fd    [ri])
  twp:addcol("wy_vs_dqy_dif"    , \ri -> twp.wy_vs_dqy_da    [ri] - twp.wy_vs_dqy_fd    [ri])
  twp:addcol("wyp_vs_dqx_dif"   , \ri -> twp.wyp_vs_dqx_da   [ri] - twp.wyp_vs_dqx_fd   [ri])
  twp:addcol("wyp_vs_dqy_dif"   , \ri -> twp.wyp_vs_dqy_da   [ri] - twp.wyp_vs_dqy_fd   [ri])
end
end

