-- Build plots ------------------------

-- save table
twp:write("twiss_prms_"..MAD.env.version..".tfs")

io.write("Making plots...\n")

local plt = plot { -- plot template
  table    = twp,
  xrange   = {0, seq.l},
  styles   = "lines", linewidth=1.5, fontsize=16,
  output   = fplt,
  exec     = false
}

---------

-- Beta functions
plt {
  title    = tplt or "Sensitivity of beta DA ("..snam..", order "..ord..")",
  x1y1     = {s = {"beta11_vs_dqx_da", "beta11_vs_dqy_da", "beta22_vs_dqx_da", "beta22_vs_dqy_da"}},
  xlabel   = "s [m]"   ,
  ylabel   = "d β_{x,y} / d q_{x,y}",
  legend   = {beta11_vs_dqx_da="d β_x/d q_x", beta11_vs_dqy_da="d β_x/d q_y",
              beta22_vs_dqx_da="d β_y/d q_x", beta22_vs_dqy_da="d β_y/d q_y"},
}
plt {
  title    = tplt or "Sensitivity of beta FD ("..snam..", order "..ord..")",
  x1y1     = {s = {"beta11_vs_dqx_fd", "beta11_vs_dqy_fd", "beta22_vs_dqx_fd", "beta22_vs_dqy_fd"}},
  xlabel   = "s [m]",
  ylabel   = "d β_{x,y} / d q_{x,y}",
  legend   = {beta11_vs_dqx_fd="d β_x/d q_x", beta11_vs_dqy_fd="d β_x/d q_y",
              beta22_vs_dqx_fd="d β_y/d q_x", beta22_vs_dqy_fd="d β_y/d q_y"},
}
plt {
  title    = tplt or "Sensitivity error of beta FD vs DA ("..snam..", order "..ord..")",
  x1y1     = {s = {"beta11_vs_dqx_dif", "beta11_vs_dqy_dif", "beta22_vs_dqx_dif", "beta22_vs_dqy_dif"}},
  xlabel   = "s [m]"   ,
  ylabel   = "Error on d β_{x,y} / d q_{x,y}",
