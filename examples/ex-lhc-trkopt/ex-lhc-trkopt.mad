  twp:addcol("alfy_vs_dqy_fd"  , \ri -> ((a*twdp.alfy  [ri] + b*twp.alfy  [ri] + c*twdm.alfy  [ri])/(d*dh^e)))
  twp:addcol("r11_vs_dcr_fd"   , \ri -> ((a*twrp.r11   [ri] + b*twp.r11   [ri] + c*twrm.r11   [ri])/(d*dh^e)))
