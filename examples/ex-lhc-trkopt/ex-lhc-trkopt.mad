-- Script Setup
local seq2 = true                 -- run also LHCB2
local reft = true                 -- compute reference track & twiss
local knbs = true                 -- check tunes knobs effectiveness
local chrm = true                 -- compute chromatic functions
local cmap = true                 -- use cmaps (or not)
local mord = 2                    -- max loop order (1 or 2)
local fplt = "ex-lhc-trkopt_"..MAD.env.version..".pdf" -- file to output plots

-- Import commands
local beam, track, twiss, damap, plot, option in MAD
-- Import utility functions
local printf, timeit, tblcat in MAD.utility

-- LHC Setup -------------------------------------------------------------------

local pbtop=beam{particle="proton", energy=6800}

MADX.option.warn=false
MADX:load("2024_lhcb1_saved.seq", "lhcb1.mad") -- convert and save on need
MADX:load("2024_lhcb2_saved.seq", "lhcb2.mad")
MADX:load("lhc_var0.mad")
MADX.option.warn=true

local lhcb1, lhcb2 in MADX
lhcb1.beam = pbtop
lhcb2.beam = pbtop
lhcb2.dir = -1 -- reverse direction

for idx,seq in ipairs{lhcb1, seq2 and lhcb2 or nil} do

-- sequence name
local snam = seq.name:lower()
io.write("Running ", snam, "\n")

-- sequence tune knobs
local bn  = ({"b1","b2"})[idx]
local dqx = "dqx_"..bn.."_op"
local dqy = "dqy_"..bn.."_op"

-- Reference Track & Twiss -----------------------------------------------------

local tk, tw

if reft or knbs then

local cols = {'name','kind','s','l','id','x','px','y','py','t','pt'}

-- Compute the reference track
tk = timeit(\ -> track {sequence=seq, observe=0, mapdef=1}, "Track Ref")
tk:write(snam.."_tk_ref.tfs", cols)

-- Compute the reference twiss
tw = timeit(\ -> twiss {sequence=seq}, "Twiss Ref")
tw:write(snam.."_tw_ref.tfs", cols)

plot {
  title    = "Optical Functions "..snam,  -- plot title
  sequence = seq,            -- sequence for layout
  table    = tw,               -- twiss table for plot
  x1y1    = {s = {"beta11", "beta22", "dx", "dy"}}, -- x vs y1 columns
  x1y2    = {s = {"mu1", "mu2"}},                   -- x vs y2 columns
  xlabel  = "s [m]"   ,                             -- x-axis label
  ylabel  = "β_{x,y} [m], D_{x,y} [m]",             -- y-axis label left
  y2label = "μ_{x,y} [rad/2π]",                     -- y-axis label right
  legend  = {beta11="β_x", beta22="β_y",            -- column labels
             mu1="μ_x", mu2="μ_y",                   --   idem
             dx="D_x", dy="D_y"},                    --   idem
  styles  = "lines", linewidth=1.5, fontsize=16,    -- styles
  output   = fplt,
}

end -- ref

-- check knobs consistency
if knbs then

local shft = 0.01

printf(" q1               = %10.7f\n",  tw.q1)
printf(" q2               = %10.7f\n",  tw.q2)

MADX[dqx] = shft
MADX[dqy] = 0
local twd = timeit(\ -> twiss {sequence=seq, observe=1}, "Twiss Chk")
printf(" q1_dqx           = %10.7f\n",  twd.q1)
printf(" q2_dqx           = %10.7f\n",  twd.q2)
printf("(q1_dqx-q1)/shft  = %10.7f\n", (twd.q1-tw.q1)/shft)
printf("(q2_dqx-q2)/shft  = %10.7f\n", (twd.q2-tw.q2)/shft)

MADX[dqx] = 0
MADX[dqy] = shft
local twd = timeit(\ -> twiss {sequence=seq, observe=1}, "Twiss Chk")
printf(" q1_dqy           = %10.7f\n",  twd.q1)
printf(" q2_dqy           = %10.7f\n",  twd.q2)
printf("(q1_dqy-q1)/shft  = %10.7f\n", (twd.q1-tw.q1)/shft)
printf("(q2_dqy-q2)/shft  = %10.7f\n", (twd.q2-tw.q2)/shft)

MADX[dqx] = shft
MADX[dqy] = shft
local twd = timeit(\ -> twiss {sequence=seq, observe=1}, "Twiss Chk")
printf(" q1_dqxy          = %10.7f\n",  twd.q1)
printf(" q2_dqxy          = %10.7f\n",  twd.q2)
printf("(q1_dqxy-q1)/shft = %10.7f\n", (twd.q1-tw.q1)/shft)
printf("(q2_dqxy-q2)/shft = %10.7f\n", (twd.q2-tw.q2)/shft)

end -- knbs

--[[
MAD-X LHCB1, shft=0.01         ; MAD-NG LHCB1, shft=0.01
q1                = 62.3100002 ;  q1               = 62.3100000
q2                = 60.3200000 ;  q2               = 60.3200000
q1_dqx            = 62.3200013 ;  q1_dqx           = 62.3200011
q2_dqx            = 60.3200007 ;  q2_dqx           = 60.3200007
(q1_dqx-q1)/shft  =  1.0001094 ; (q1_dqx-q1)/shft  =  1.0001105
(q2_dqx-q2)/shft  =  0.0000699 ; (q2_dqx-q2)/shft  =  0.0000701
q1_dqy            = 62.3100009 ;  q1_dqy           = 62.3100007
q2_dqy            = 60.3300011 ;  q2_dqy           = 60.3300011
(q1_dqy-q1)/shft  =  0.0000705 ; (q1_dqy-q1)/shft  =  0.0000705
(q2_dqy-q2)/shft  =  1.0001113 ; (q2_dqy-q2)/shft  =  1.0001113
q1_dqxy           = 62.3200061 ;  q1_dqxy          = 62.3200059
q2_dqxy           = 60.3300059 ;  q2_dqxy          = 60.3300059
(q1_dqxy-q1)/shft =  1.0005908 ; (q1_dqxy-q1)/shft =  1.0005919
(q2_dqxy-q2)/shft =  1.0005918 ; (q2_dqxy-q2)/shft =  1.0005921
                               ;
MAD-X LHCB2, shft=0.01         ; MAD-NG LHCB2, shft=0.01
q1                = 62.3100004 ;  q1               = 62.3100000
q2                = 60.3200000 ;  q2               = 60.3200000
q1_dqx            = 62.3200015 ;  q1_dqx           = 62.3200011
q2_dqx            = 60.3200007 ;  q2_dqx           = 60.3200007
(q1_dqx-q1)/shft  =  1.0001122 ; (q1_dqx-q1)/shft  =  1.0001135
(q2_dqx-q2)/shft  =  0.0000705 ; (q2_dqx-q2)/shft  =  0.0000707
q1_dqy            = 62.3100011 ;  q1_dqy           = 62.3100007
q2_dqy            = 60.3300007 ;  q2_dqy           = 60.3300007
(q1_dqy-q1)/shft  =  0.0000710 ; (q1_dqy-q1)/shft  =  0.0000710
(q2_dqy-q2)/shft  =  1.0000691 ; (q2_dqy-q2)/shft  =  1.0000691
q1_dqxy           = 62.3200063 ;  q1_dqxy          = 62.3200060
q2_dqxy           = 60.3300055 ;  q2_dqxy          = 60.3300054
(q1_dqxy-q1)/shft =  1.0005956 ; (q1_dqxy-q1)/shft =  1.0005969
(q2_dqxy-q2)/shft =  1.0005418 ; (q2_dqxy-q2)/shft =  1.0005420
--]]

-- First and Second derivative check -------------------------------------------

-- Optical functions to check
local kopts = {
  tblcat(
  {"beta11_10", "beta11_01", "beta22_10", "beta22_01", -- 1
  "alfa11_10", "alfa11_01", "alfa22_10", "alfa22_01" , -- 5
  "gama11_10", "gama11_01", "gama22_10", "gama22_01" , -- 9
  "mu1_10"   , "mu1_01"   , "mu2_10"   , "mu2_01"    , -- 13
  "disp1_10" , "disp1_01" , "disp2_10" , "disp2_01"  , -- 17
  "disp3_10" , "disp3_01" , "disp4_10" , "disp4_01"} , -- 21
  not chrm and {} or
  {"dmu1_10" , "dmu1_01"  , "dmu2_10"  , "dmu2_01"   , -- 25
   "wx_10"   , "wx_01"    , "wxp_10"   , "wxp_01"    , -- 29
   "wy_10"   , "wy_01"    , "wyp_10"   , "wyp_01"  })  -- 33
  ,
  tblcat(
  {"beta11_20", "beta11_02", "beta22_20", "beta22_02", -- 1
  "alfa11_20", "alfa11_02", "alfa22_20", "alfa22_02" , -- 5
  "gama11_20", "gama11_02", "gama22_20", "gama22_02" , -- 9
  "mu1_20"   , "mu1_02"   , "mu2_20"   , "mu2_02"    , -- 13
  "disp1_20" , "disp1_02" , "disp2_20" , "disp2_02"  , -- 17
  "disp3_20" , "disp3_02" , "disp4_20" , "disp4_02"} , -- 21
  not chrm and {} or
  {"dmu1_20" , "dmu1_02"  , "dmu2_20"  , "dmu2_02"   , -- 25
   "wx_20"   , "wx_02"    , "wxp_20"   , "wxp_02"    , -- 29
   "wy_20"   , "wy_02"    , "wyp_20"   , "wyp_02"  })  -- 33
}

-- Loop over orders -------------------
for ord=1,mord do

io.write("Checking Order ", ord, " for ", snam, "\n")

local nk = 24+(chrm and 12 or 0)
assert(#kopts[ord] == nk, "invalid kopts, expecting "..nk.." got "..#kopts[ord])

-- Compute parametric twiss -----------
local mo = ord+(chrm and 2 or 1)
local x0 = damap { nv=6, np=2, no={mo,mo,mo,mo,1,1}, po=ord, pn={"dqx", "dqy"} }

MADX[dqx] = MADX[dqx] + x0.dqx
MADX[dqy] = MADX[dqy] + x0.dqy

local twp = timeit(\ -> twiss {sequence=seq, X0=x0, trkopt=kopts[ord], chrom=chrm, cmap=cmap}, "Twiss DA")

MADX[dqx] = MADX[dqx]:get0()
MADX[dqy] = MADX[dqy]:get0()

-- extend table with parametric values
twp:addcol("beta11_vs_dqx_da", \ri -> twp[kopts[ord][ 1]][ri])
twp:addcol("beta11_vs_dqy_da", \ri -> twp[kopts[ord][ 2]][ri])
twp:addcol("beta22_vs_dqx_da", \ri -> twp[kopts[ord][ 3]][ri])
twp:addcol("beta22_vs_dqy_da", \ri -> twp[kopts[ord][ 4]][ri])
twp:addcol("alfa11_vs_dqx_da", \ri -> twp[kopts[ord][ 5]][ri])
twp:addcol("alfa11_vs_dqy_da", \ri -> twp[kopts[ord][ 6]][ri])
twp:addcol("alfa22_vs_dqx_da", \ri -> twp[kopts[ord][ 7]][ri])
twp:addcol("alfa22_vs_dqy_da", \ri -> twp[kopts[ord][ 8]][ri])
twp:addcol("gama11_vs_dqx_da", \ri -> twp[kopts[ord][ 9]][ri])
twp:addcol("gama11_vs_dqy_da", \ri -> twp[kopts[ord][10]][ri])
twp:addcol("gama22_vs_dqx_da", \ri -> twp[kopts[ord][11]][ri])
twp:addcol("gama22_vs_dqy_da", \ri -> twp[kopts[ord][12]][ri])
twp:addcol("mu1_vs_dqx_da"   , \ri -> twp[kopts[ord][13]][ri])
twp:addcol("mu1_vs_dqy_da"   , \ri -> twp[kopts[ord][14]][ri])
twp:addcol("mu2_vs_dqx_da"   , \ri -> twp[kopts[ord][15]][ri])
twp:addcol("mu2_vs_dqy_da"   , \ri -> twp[kopts[ord][16]][ri])
twp:addcol("dx_vs_dqx_da"    , \ri -> twp[kopts[ord][17]][ri])
twp:addcol("dx_vs_dqy_da"    , \ri -> twp[kopts[ord][18]][ri])
twp:addcol("dpx_vs_dqx_da"   , \ri -> twp[kopts[ord][19]][ri])
twp:addcol("dpx_vs_dqy_da"   , \ri -> twp[kopts[ord][20]][ri])
twp:addcol("dy_vs_dqx_da"    , \ri -> twp[kopts[ord][21]][ri])
twp:addcol("dy_vs_dqy_da"    , \ri -> twp[kopts[ord][22]][ri])
twp:addcol("dpy_vs_dqx_da"   , \ri -> twp[kopts[ord][23]][ri])
twp:addcol("dpy_vs_dqy_da"   , \ri -> twp[kopts[ord][24]][ri])
if chrm then
twp:addcol("dmu1_vs_dqx_da"  , \ri -> twp[kopts[ord][25]][ri])
twp:addcol("dmu1_vs_dqy_da"  , \ri -> twp[kopts[ord][26]][ri])
twp:addcol("dmu2_vs_dqx_da"  , \ri -> twp[kopts[ord][27]][ri])
twp:addcol("dmu2_vs_dqy_da"  , \ri -> twp[kopts[ord][28]][ri])
twp:addcol("wx_vs_dqx_da"    , \ri -> twp[kopts[ord][29]][ri])
twp:addcol("wx_vs_dqy_da"    , \ri -> twp[kopts[ord][30]][ri])
twp:addcol("wxp_vs_dqx_da"   , \ri -> twp[kopts[ord][31]][ri])
twp:addcol("wxp_vs_dqy_da"   , \ri -> twp[kopts[ord][32]][ri])
twp:addcol("wy_vs_dqx_da"    , \ri -> twp[kopts[ord][33]][ri])
twp:addcol("wy_vs_dqy_da"    , \ri -> twp[kopts[ord][34]][ri])
twp:addcol("wyp_vs_dqx_da"   , \ri -> twp[kopts[ord][35]][ri])
twp:addcol("wyp_vs_dqy_da"   , \ri -> twp[kopts[ord][36]][ri])
end

-- Compute finite difference twiss ----

local dh = ({5e-6, 5e-4})[ord] -- finite differences step

-- twiss with dqx as dh
MADX[dqx] = MADX[dqx] + dh
local twfp = timeit(\ -> twiss {sequence=seq, chrom=chrm, cmap=cmap}, "Twiss FD dqx+dh")
MADX[dqx] = MADX[dqx] - 2*dh
local twfm = timeit(\ -> twiss {sequence=seq, chrom=chrm, cmap=cmap}, "Twiss FD dqx-dh")
MADX[dqx] = MADX[dqx] + dh

-- twiss with dqy as dh
MADX[dqy] = MADX[dqy] + dh
local twdp = timeit(\ -> twiss {sequence=seq, chrom=chrm, cmap=cmap}, "Twiss FD dqy+dh")
MADX[dqy] = MADX[dqy] - 2*dh
local twdm = timeit(\ -> twiss {sequence=seq, chrom=chrm, cmap=cmap}, "Twiss FD dqy-dh")
MADX[dqy] = MADX[dqy] + dh

do
  local a,b,c,d,e in ({
    { a=1, b= 0, c=-1, d=2, e=1 },
    { a=1, b=-2, c= 1, d=1, e=2 },
  })[ord]

  -- extend table with finite difference values
  twp:addcol("beta11_vs_dqx_fd", \ri -> ((a*twfp.beta11[ri] + b*twp.beta11[ri] + c*twfm.beta11[ri])/(d*dh^e)))
  twp:addcol("beta11_vs_dqy_fd", \ri -> ((a*twdp.beta11[ri] + b*twp.beta11[ri] + c*twdm.beta11[ri])/(d*dh^e)))
  twp:addcol("beta22_vs_dqx_fd", \ri -> ((a*twfp.beta22[ri] + b*twp.beta22[ri] + c*twfm.beta22[ri])/(d*dh^e)))
  twp:addcol("beta22_vs_dqy_fd", \ri -> ((a*twdp.beta22[ri] + b*twp.beta22[ri] + c*twdm.beta22[ri])/(d*dh^e)))
  twp:addcol("alfa11_vs_dqx_fd", \ri -> ((a*twfp.alfa11[ri] + b*twp.alfa11[ri] + c*twfm.alfa11[ri])/(d*dh^e)))
  twp:addcol("alfa11_vs_dqy_fd", \ri -> ((a*twdp.alfa11[ri] + b*twp.alfa11[ri] + c*twdm.alfa11[ri])/(d*dh^e)))
  twp:addcol("alfa22_vs_dqx_fd", \ri -> ((a*twfp.alfa22[ri] + b*twp.alfa22[ri] + c*twfm.alfa22[ri])/(d*dh^e)))
  twp:addcol("alfa22_vs_dqy_fd", \ri -> ((a*twdp.alfa22[ri] + b*twp.alfa22[ri] + c*twdm.alfa22[ri])/(d*dh^e)))
  twp:addcol("gama11_vs_dqx_fd", \ri -> ((a*twfp.gama11[ri] + b*twp.gama11[ri] + c*twfm.gama11[ri])/(d*dh^e)))
  twp:addcol("gama11_vs_dqy_fd", \ri -> ((a*twdp.gama11[ri] + b*twp.gama11[ri] + c*twdm.gama11[ri])/(d*dh^e)))
  twp:addcol("gama22_vs_dqx_fd", \ri -> ((a*twfp.gama22[ri] + b*twp.gama22[ri] + c*twfm.gama22[ri])/(d*dh^e)))
  twp:addcol("gama22_vs_dqy_fd", \ri -> ((a*twdp.gama22[ri] + b*twp.gama22[ri] + c*twdm.gama22[ri])/(d*dh^e)))
  twp:addcol("mu1_vs_dqx_fd"   , \ri -> ((a*twfp.mu1   [ri] + b*twp.mu1   [ri] + c*twfm.mu1   [ri])/(d*dh^e)))
  twp:addcol("mu1_vs_dqy_fd"   , \ri -> ((a*twdp.mu1   [ri] + b*twp.mu1   [ri] + c*twdm.mu1   [ri])/(d*dh^e)))
  twp:addcol("mu2_vs_dqx_fd"   , \ri -> ((a*twfp.mu2   [ri] + b*twp.mu2   [ri] + c*twfm.mu2   [ri])/(d*dh^e)))
  twp:addcol("mu2_vs_dqy_fd"   , \ri -> ((a*twdp.mu2   [ri] + b*twp.mu2   [ri] + c*twdm.mu2   [ri])/(d*dh^e)))
  twp:addcol("dx_vs_dqx_fd"    , \ri -> ((a*twfp.dx    [ri] + b*twp.dx    [ri] + c*twfm.dx    [ri])/(d*dh^e)))
  twp:addcol("dx_vs_dqy_fd"    , \ri -> ((a*twdp.dx    [ri] + b*twp.dx    [ri] + c*twdm.dx    [ri])/(d*dh^e)))
  twp:addcol("dpx_vs_dqx_fd"   , \ri -> ((a*twfp.dpx   [ri] + b*twp.dpx   [ri] + c*twfm.dpx   [ri])/(d*dh^e)))
  twp:addcol("dpx_vs_dqy_fd"   , \ri -> ((a*twdp.dpx   [ri] + b*twp.dpx   [ri] + c*twdm.dpx   [ri])/(d*dh^e)))
  twp:addcol("dy_vs_dqx_fd"    , \ri -> ((a*twfp.dy    [ri] + b*twp.dy    [ri] + c*twfm.dy    [ri])/(d*dh^e)))
  twp:addcol("dy_vs_dqy_fd"    , \ri -> ((a*twdp.dy    [ri] + b*twp.dy    [ri] + c*twdm.dy    [ri])/(d*dh^e)))
  twp:addcol("dpy_vs_dqx_fd"   , \ri -> ((a*twfp.dpy   [ri] + b*twp.dpy   [ri] + c*twfm.dpy   [ri])/(d*dh^e)))
  twp:addcol("dpy_vs_dqy_fd"   , \ri -> ((a*twdp.dpy   [ri] + b*twp.dpy   [ri] + c*twdm.dpy   [ri])/(d*dh^e)))
if chrm then
  twp:addcol("dmu1_vs_dqx_fd"  , \ri -> ((a*twfp.dmu1  [ri] + b*twp.dmu1  [ri] + c*twfm.dmu1  [ri])/(d*dh^e)))
  twp:addcol("dmu1_vs_dqy_fd"  , \ri -> ((a*twdp.dmu1  [ri] + b*twp.dmu1  [ri] + c*twdm.dmu1  [ri])/(d*dh^e)))
  twp:addcol("dmu2_vs_dqx_fd"  , \ri -> ((a*twfp.dmu2  [ri] + b*twp.dmu2  [ri] + c*twfm.dmu2  [ri])/(d*dh^e)))
  twp:addcol("dmu2_vs_dqy_fd"  , \ri -> ((a*twdp.dmu2  [ri] + b*twp.dmu2  [ri] + c*twdm.dmu2  [ri])/(d*dh^e)))
  twp:addcol("wx_vs_dqx_fd"    , \ri -> ((a*twfp.wx    [ri] + b*twp.wx    [ri] + c*twfm.wx    [ri])/(d*dh^e)))
  twp:addcol("wx_vs_dqy_fd"    , \ri -> ((a*twdp.wx    [ri] + b*twp.wx    [ri] + c*twdm.wx    [ri])/(d*dh^e)))
  twp:addcol("wxp_vs_dqx_fd"   , \ri -> ((a*twfp.phix  [ri] + b*twp.phix  [ri] + c*twfm.phix  [ri])/(d*dh^e)))
  twp:addcol("wxp_vs_dqy_fd"   , \ri -> ((a*twdp.phix  [ri] + b*twp.phix  [ri] + c*twdm.phix  [ri])/(d*dh^e)))
  twp:addcol("wy_vs_dqx_fd"    , \ri -> ((a*twfp.wy    [ri] + b*twp.wy    [ri] + c*twfm.wy    [ri])/(d*dh^e)))
  twp:addcol("wy_vs_dqy_fd"    , \ri -> ((a*twdp.wy    [ri] + b*twp.wy    [ri] + c*twdm.wy    [ri])/(d*dh^e)))
  twp:addcol("wyp_vs_dqx_fd"   , \ri -> ((a*twfp.phiy  [ri] + b*twp.phiy  [ri] + c*twfm.phiy  [ri])/(d*dh^e)))
  twp:addcol("wyp_vs_dqy_fd"   , \ri -> ((a*twdp.phiy  [ri] + b*twp.phiy  [ri] + c*twdm.phiy  [ri])/(d*dh^e)))
end
end

-- Build plots ------------------------

do
  twp:addcol("beta11_vs_dqx_dif", \ri -> twp.beta11_vs_dqx_da[ri] - twp.beta11_vs_dqx_fd[ri])
  twp:addcol("beta11_vs_dqy_dif", \ri -> twp.beta11_vs_dqy_da[ri] - twp.beta11_vs_dqy_fd[ri])
  twp:addcol("beta22_vs_dqx_dif", \ri -> twp.beta22_vs_dqx_da[ri] - twp.beta22_vs_dqx_fd[ri])
  twp:addcol("beta22_vs_dqy_dif", \ri -> twp.beta22_vs_dqy_da[ri] - twp.beta22_vs_dqy_fd[ri])
  twp:addcol("alfa11_vs_dqx_dif", \ri -> twp.alfa11_vs_dqx_da[ri] - twp.alfa11_vs_dqx_fd[ri])
  twp:addcol("alfa11_vs_dqy_dif", \ri -> twp.alfa11_vs_dqy_da[ri] - twp.alfa11_vs_dqy_fd[ri])
  twp:addcol("alfa22_vs_dqx_dif", \ri -> twp.alfa22_vs_dqx_da[ri] - twp.alfa22_vs_dqx_fd[ri])
  twp:addcol("alfa22_vs_dqy_dif", \ri -> twp.alfa22_vs_dqy_da[ri] - twp.alfa22_vs_dqy_fd[ri])
  twp:addcol("gama11_vs_dqx_dif", \ri -> twp.gama11_vs_dqx_da[ri] - twp.gama11_vs_dqx_fd[ri])
  twp:addcol("gama11_vs_dqy_dif", \ri -> twp.gama11_vs_dqy_da[ri] - twp.gama11_vs_dqy_fd[ri])
  twp:addcol("gama22_vs_dqx_dif", \ri -> twp.gama22_vs_dqx_da[ri] - twp.gama22_vs_dqx_fd[ri])
  twp:addcol("gama22_vs_dqy_dif", \ri -> twp.gama22_vs_dqy_da[ri] - twp.gama22_vs_dqy_fd[ri])
  twp:addcol("mu1_vs_dqx_dif"   , \ri -> twp.mu1_vs_dqx_da   [ri] - twp.mu1_vs_dqx_fd   [ri])
  twp:addcol("mu1_vs_dqy_dif"   , \ri -> twp.mu1_vs_dqy_da   [ri] - twp.mu1_vs_dqy_fd   [ri])
  twp:addcol("mu2_vs_dqx_dif"   , \ri -> twp.mu2_vs_dqx_da   [ri] - twp.mu2_vs_dqx_fd   [ri])
  twp:addcol("mu2_vs_dqy_dif"   , \ri -> twp.mu2_vs_dqy_da   [ri] - twp.mu2_vs_dqy_fd   [ri])
  twp:addcol("dx_vs_dqx_dif"    , \ri -> twp.dx_vs_dqx_da    [ri] - twp.dx_vs_dqx_fd    [ri])
  twp:addcol("dx_vs_dqy_dif"    , \ri -> twp.dx_vs_dqy_da    [ri] - twp.dx_vs_dqy_fd    [ri])
  twp:addcol("dpx_vs_dqx_dif"   , \ri -> twp.dpx_vs_dqx_da   [ri] - twp.dpx_vs_dqx_fd   [ri])
  twp:addcol("dpx_vs_dqy_dif"   , \ri -> twp.dpx_vs_dqy_da   [ri] - twp.dpx_vs_dqy_fd   [ri])
  twp:addcol("dy_vs_dqx_dif"    , \ri -> twp.dy_vs_dqx_da    [ri] - twp.dy_vs_dqx_fd    [ri])
  twp:addcol("dy_vs_dqy_dif"    , \ri -> twp.dy_vs_dqy_da    [ri] - twp.dy_vs_dqy_fd    [ri])
  twp:addcol("dpy_vs_dqx_dif"   , \ri -> twp.dpy_vs_dqx_da   [ri] - twp.dpy_vs_dqx_fd   [ri])
  twp:addcol("dpy_vs_dqy_dif"   , \ri -> twp.dpy_vs_dqy_da   [ri] - twp.dpy_vs_dqy_fd   [ri])
if chrm then
  twp:addcol("dmu1_vs_dqx_dif"  , \ri -> twp.dmu1_vs_dqx_da  [ri] - twp.dmu1_vs_dqx_fd  [ri])
  twp:addcol("dmu1_vs_dqy_dif"  , \ri -> twp.dmu1_vs_dqy_da  [ri] - twp.dmu1_vs_dqy_fd  [ri])
  twp:addcol("dmu2_vs_dqx_dif"  , \ri -> twp.dmu2_vs_dqx_da  [ri] - twp.dmu2_vs_dqx_fd  [ri])
  twp:addcol("dmu2_vs_dqy_dif"  , \ri -> twp.dmu2_vs_dqy_da  [ri] - twp.dmu2_vs_dqy_fd  [ri])
  twp:addcol("wx_vs_dqx_dif"    , \ri -> twp.wx_vs_dqx_da    [ri] - twp.wx_vs_dqx_fd    [ri])
  twp:addcol("wx_vs_dqy_dif"    , \ri -> twp.wx_vs_dqy_da    [ri] - twp.wx_vs_dqy_fd    [ri])
