-- Script Setup
local reft = false                -- compute reference twiss
local chrm = false                -- compute chromatic functions
local cmap = true                 -- use cmaps (or not)
local mord = 1                    -- max loop order (1 or 2)
local dh   = 3e-4                 -- finite differences step
local fplt = "ex-lhcb1-trkopt.pdf" -- file to output plots

-- Import commands
local beam, twiss, damap, plot in MAD
-- Import utility functions
local printf, timeit, tblcat in MAD.utility

-- LHC Setup -------------------------------------------------------------------

local pbtop=beam{particle="proton", energy=6800}

MADX:load("2024_lhcb1_saved.seq", "lhcb1.mad") -- convert and save on need
MADX:load("lhcb1_var0.mad")
local lhcb1 in MADX
lhcb1.beam = pbtop

-- MADX:load("2024_lhcb2_saved.seq", "lhcb2.mad")
-- local lhcb2 in MADX
-- lhcb2.dir = -1 -- reverse direction
-- lhcb2.beam = pbtop

-- Reference Twiss ------------------------------------------------------------

if reft then

-- Compute the reference optic functions
local tw = timeit(\ -> twiss {sequence=lhcb1, cmap=cmap}, "Twiss Ref")

plot {
  title    = "Optical Functions",  -- plot title
  sequence = lhcb1,            -- sequence for layout
  table    = tw,               -- twiss table for plot
  x1y1    = {s = {"beta11", "beta22", "dx", "dy"}}, -- x vs y1 columns
  x1y2    = {s = {"mu1", "mu2"}},                   -- x vs y2 columns
  xlabel  = "s [m]"   ,                             -- x-axis label
  ylabel  = "β_{x,y} [m], D_{x,y} [m]",             -- y-axis label left
  y2label = "μ_{x,y} [rad/2π]",                     -- y-axis label right
  legend  = {beta11="β_x", beta22="β_y",            -- column labels
             mu1="μ_x", mu2="μ_y",                   --   idem
             dx="D_x", dy="D_y"},                    --   idem
  styles  = "lines", linewidth=1.5, fontsize=16,    -- styles
  output   = fplt,
}

end

-- First and Second derivative check -------------------------------------------

-- Optical functions to check
local kopts = {
  tblcat(
  {"beta11_10", "beta11_01", "beta22_10", "beta22_01", -- 1
  "alfa11_10", "alfa11_01", "alfa22_10", "alfa22_01" , -- 5
  "gama11_10", "gama11_01", "gama22_10", "gama22_01" , -- 9
  "mu1_10"   , "mu1_01"   , "mu2_10"   , "mu2_01"    , -- 13
  "disp1_10" , "disp1_01" , "disp2_10" , "disp2_01"  , -- 17
  "disp3_10" , "disp3_01" , "disp4_10" , "disp4_01"} , -- 21
  not chrm and {} or
  {"dmu1_10" , "dmu1_01"  , "dmu2_10"  , "dmu2_01"   , -- 25
   "wx_10"   , "wx_01"    , "wxp_10"   , "wxp_01"    , -- 29
   "wy_10"   , "wy_01"    , "wyp_10"   , "wyp_01"  })  -- 33
  ,
  tblcat(
  {"beta11_20", "beta11_02", "beta22_20", "beta22_02", -- 1
  "alfa11_20", "alfa11_02", "alfa22_20", "alfa22_02" , -- 5
  "gama11_20", "gama11_02", "gama22_20", "gama22_02" , -- 9
  "mu1_20"   , "mu1_02"   , "mu2_20"   , "mu2_02"    , -- 13
  "disp1_20" , "disp1_02" , "disp2_20" , "disp2_02"  , -- 17
  "disp3_20" , "disp3_02" , "disp4_20" , "disp4_02"} , -- 21
  not chrm and {} or
  {"dmu1_20" , "dmu1_02"  , "dmu2_20"  , "dmu2_02"   , -- 25
   "wx_20"   , "wx_02"    , "wxp_20"   , "wxp_02"    , -- 29
   "wy_20"   , "wy_02"    , "wyp_20"   , "wyp_02"  })  -- 33
}

-- Loop over orders -------------------
for ord=1,mord do

io.write("Checking Order ", ord, "\n")

local nk = 24+(chrm and 12 or 0)
assert(#kopts[ord] == nk, "invalid kopts, expecting "..nk.." got "..#kopts[ord])

-- Compute parametric twiss -----------
local mo = ord+(chrm and 2 or 1)
local x0 = damap { nv=6, np=2, no={mo,mo,mo,mo,1,1}, po=ord, pn={"dqx", "dqy"} }

MADX.dqx_b1_op = MADX.dqx_b1_op + x0.dqx
MADX.dqy_b1_op = MADX.dqy_b1_op + x0.dqy

local twp = timeit(\ -> twiss {sequence=lhcb1, X0=x0, trkopt=kopts[ord], chrom=chrm, cmap=cmap}, "Twiss DA")

MADX.dqx_b1_op = MADX.dqx_b1_op:get0()
MADX.dqy_b1_op = MADX.dqy_b1_op:get0()

-- extend table with parametric values
twp:addcol("beta11_vs_k1f_da", \ri -> twp[kopts[ord][ 1]][ri])
twp:addcol("beta11_vs_k1d_da", \ri -> twp[kopts[ord][ 2]][ri])
twp:addcol("beta22_vs_k1f_da", \ri -> twp[kopts[ord][ 3]][ri])
twp:addcol("beta22_vs_k1d_da", \ri -> twp[kopts[ord][ 4]][ri])
twp:addcol("alfa11_vs_k1f_da", \ri -> twp[kopts[ord][ 5]][ri])
twp:addcol("alfa11_vs_k1d_da", \ri -> twp[kopts[ord][ 6]][ri])
twp:addcol("alfa22_vs_k1f_da", \ri -> twp[kopts[ord][ 7]][ri])
twp:addcol("alfa22_vs_k1d_da", \ri -> twp[kopts[ord][ 8]][ri])
twp:addcol("gama11_vs_k1f_da", \ri -> twp[kopts[ord][ 9]][ri])
twp:addcol("gama11_vs_k1d_da", \ri -> twp[kopts[ord][10]][ri])
twp:addcol("gama22_vs_k1f_da", \ri -> twp[kopts[ord][11]][ri])
twp:addcol("gama22_vs_k1d_da", \ri -> twp[kopts[ord][12]][ri])
twp:addcol("mu1_vs_k1f_da"   , \ri -> twp[kopts[ord][13]][ri])
twp:addcol("mu1_vs_k1d_da"   , \ri -> twp[kopts[ord][14]][ri])
twp:addcol("mu2_vs_k1f_da"   , \ri -> twp[kopts[ord][15]][ri])
twp:addcol("mu2_vs_k1d_da"   , \ri -> twp[kopts[ord][16]][ri])
twp:addcol("dx_vs_k1f_da"    , \ri -> twp[kopts[ord][17]][ri])
twp:addcol("dx_vs_k1d_da"    , \ri -> twp[kopts[ord][18]][ri])
twp:addcol("dpx_vs_k1f_da"   , \ri -> twp[kopts[ord][19]][ri])
twp:addcol("dpx_vs_k1d_da"   , \ri -> twp[kopts[ord][20]][ri])
twp:addcol("dy_vs_k1f_da"    , \ri -> twp[kopts[ord][21]][ri])
twp:addcol("dy_vs_k1d_da"    , \ri -> twp[kopts[ord][22]][ri])
twp:addcol("dpy_vs_k1f_da"   , \ri -> twp[kopts[ord][23]][ri])
twp:addcol("dpy_vs_k1d_da"   , \ri -> twp[kopts[ord][24]][ri])
if chrm then
twp:addcol("dmu1_vs_k1f_da"  , \ri -> twp[kopts[ord][25]][ri])
twp:addcol("dmu1_vs_k1d_da"  , \ri -> twp[kopts[ord][26]][ri])
twp:addcol("dmu2_vs_k1f_da"  , \ri -> twp[kopts[ord][27]][ri])
twp:addcol("dmu2_vs_k1d_da"  , \ri -> twp[kopts[ord][28]][ri])
twp:addcol("wx_vs_k1f_da"    , \ri -> twp[kopts[ord][29]][ri])
twp:addcol("wx_vs_k1d_da"    , \ri -> twp[kopts[ord][30]][ri])
twp:addcol("wxp_vs_k1f_da"   , \ri -> twp[kopts[ord][31]][ri])
twp:addcol("wxp_vs_k1d_da"   , \ri -> twp[kopts[ord][32]][ri])
twp:addcol("wy_vs_k1f_da"    , \ri -> twp[kopts[ord][33]][ri])
twp:addcol("wy_vs_k1d_da"    , \ri -> twp[kopts[ord][34]][ri])
twp:addcol("wyp_vs_k1f_da"   , \ri -> twp[kopts[ord][35]][ri])
twp:addcol("wyp_vs_k1d_da"   , \ri -> twp[kopts[ord][36]][ri])
end

-- Compute finite difference twiss ----

-- twiss with k1f as dh
MADX.dqx_b1_op = MADX.dqx_b1_op + dh
local twfp = timeit(\ -> twiss {sequence=lhcb1, chrom=chrm, cmap=cmap}, "Twiss FD dqx+dh")
MADX.dqx_b1_op = MADX.dqx_b1_op - 2*dh
local twfm = timeit(\ -> twiss {sequence=lhcb1, chrom=chrm, cmap=cmap}, "Twiss FD dqx-dh")
MADX.dqx_b1_op = MADX.dqx_b1_op + dh

-- twiss with k1d as dh
MADX.dqy_b1_op = MADX.dqy_b1_op + dh
local twdp = timeit(\ -> twiss {sequence=lhcb1, chrom=chrm, cmap=cmap}, "Twiss FD dqy+dh")
MADX.dqy_b1_op = MADX.dqy_b1_op - 2*dh
local twdm = timeit(\ -> twiss {sequence=lhcb1, chrom=chrm, cmap=cmap}, "Twiss FD dqy-dh")
MADX.dqy_b1_op = MADX.dqy_b1_op + dh

do
  local a,b,c,d,e in ({
    { a=1, b= 0, c=-1, d=2, e=1 },
    { a=1, b=-2, c= 1, d=1, e=2 },
  })[ord]

  -- extend table with finite difference values
  twp:addcol("beta11_vs_k1f_fd", \ri -> ((a*twfp.beta11[ri] + b*twp.beta11[ri] + c*twfm.beta11[ri])/(d*dh^e)))
  twp:addcol("beta11_vs_k1d_fd", \ri -> ((a*twdp.beta11[ri] + b*twp.beta11[ri] + c*twdm.beta11[ri])/(d*dh^e)))
  twp:addcol("beta22_vs_k1f_fd", \ri -> ((a*twfp.beta22[ri] + b*twp.beta22[ri] + c*twfm.beta22[ri])/(d*dh^e)))
  twp:addcol("beta22_vs_k1d_fd", \ri -> ((a*twdp.beta22[ri] + b*twp.beta22[ri] + c*twdm.beta22[ri])/(d*dh^e)))
  twp:addcol("alfa11_vs_k1f_fd", \ri -> ((a*twfp.alfa11[ri] + b*twp.alfa11[ri] + c*twfm.alfa11[ri])/(d*dh^e)))
  twp:addcol("alfa11_vs_k1d_fd", \ri -> ((a*twdp.alfa11[ri] + b*twp.alfa11[ri] + c*twdm.alfa11[ri])/(d*dh^e)))
  twp:addcol("alfa22_vs_k1f_fd", \ri -> ((a*twfp.alfa22[ri] + b*twp.alfa22[ri] + c*twfm.alfa22[ri])/(d*dh^e)))
  twp:addcol("alfa22_vs_k1d_fd", \ri -> ((a*twdp.alfa22[ri] + b*twp.alfa22[ri] + c*twdm.alfa22[ri])/(d*dh^e)))
  twp:addcol("gama11_vs_k1f_fd", \ri -> ((a*twfp.gama11[ri] + b*twp.gama11[ri] + c*twfm.gama11[ri])/(d*dh^e)))
  twp:addcol("gama11_vs_k1d_fd", \ri -> ((a*twdp.gama11[ri] + b*twp.gama11[ri] + c*twdm.gama11[ri])/(d*dh^e)))
  twp:addcol("gama22_vs_k1f_fd", \ri -> ((a*twfp.gama22[ri] + b*twp.gama22[ri] + c*twfm.gama22[ri])/(d*dh^e)))
  twp:addcol("gama22_vs_k1d_fd", \ri -> ((a*twdp.gama22[ri] + b*twp.gama22[ri] + c*twdm.gama22[ri])/(d*dh^e)))
  twp:addcol("mu1_vs_k1f_fd"   , \ri -> ((a*twfp.mu1   [ri] + b*twp.mu1   [ri] + c*twfm.mu1   [ri])/(d*dh^e)))
  twp:addcol("mu1_vs_k1d_fd"   , \ri -> ((a*twdp.mu1   [ri] + b*twp.mu1   [ri] + c*twdm.mu1   [ri])/(d*dh^e)))
  twp:addcol("mu2_vs_k1f_fd"   , \ri -> ((a*twfp.mu2   [ri] + b*twp.mu2   [ri] + c*twfm.mu2   [ri])/(d*dh^e)))
  twp:addcol("mu2_vs_k1d_fd"   , \ri -> ((a*twdp.mu2   [ri] + b*twp.mu2   [ri] + c*twdm.mu2   [ri])/(d*dh^e)))
  twp:addcol("dx_vs_k1f_fd"    , \ri -> ((a*twfp.dx    [ri] + b*twp.dx    [ri] + c*twfm.dx    [ri])/(d*dh^e)))
  twp:addcol("dx_vs_k1d_fd"    , \ri -> ((a*twdp.dx    [ri] + b*twp.dx    [ri] + c*twdm.dx    [ri])/(d*dh^e)))
  twp:addcol("dpx_vs_k1f_fd"   , \ri -> ((a*twfp.dpx   [ri] + b*twp.dpx   [ri] + c*twfm.dpx   [ri])/(d*dh^e)))
  twp:addcol("dpx_vs_k1d_fd"   , \ri -> ((a*twdp.dpx   [ri] + b*twp.dpx   [ri] + c*twdm.dpx   [ri])/(d*dh^e)))
  twp:addcol("dy_vs_k1f_fd"    , \ri -> ((a*twfp.dy    [ri] + b*twp.dy    [ri] + c*twfm.dy    [ri])/(d*dh^e)))
  twp:addcol("dy_vs_k1d_fd"    , \ri -> ((a*twdp.dy    [ri] + b*twp.dy    [ri] + c*twdm.dy    [ri])/(d*dh^e)))
  twp:addcol("dpy_vs_k1f_fd"   , \ri -> ((a*twfp.dpy   [ri] + b*twp.dpy   [ri] + c*twfm.dpy   [ri])/(d*dh^e)))
  twp:addcol("dpy_vs_k1d_fd"   , \ri -> ((a*twdp.dpy   [ri] + b*twp.dpy   [ri] + c*twdm.dpy   [ri])/(d*dh^e)))
if chrm then
  twp:addcol("dmu1_vs_k1f_fd"  , \ri -> ((a*twfp.dmu1  [ri] + b*twp.dmu1  [ri] + c*twfm.dmu1  [ri])/(d*dh^e)))
  twp:addcol("dmu1_vs_k1d_fd"  , \ri -> ((a*twdp.dmu1  [ri] + b*twp.dmu1  [ri] + c*twdm.dmu1  [ri])/(d*dh^e)))
  twp:addcol("dmu2_vs_k1f_fd"  , \ri -> ((a*twfp.dmu2  [ri] + b*twp.dmu2  [ri] + c*twfm.dmu2  [ri])/(d*dh^e)))
  twp:addcol("dmu2_vs_k1d_fd"  , \ri -> ((a*twdp.dmu2  [ri] + b*twp.dmu2  [ri] + c*twdm.dmu2  [ri])/(d*dh^e)))
  twp:addcol("wx_vs_k1f_fd"    , \ri -> ((a*twfp.wx    [ri] + b*twp.wx    [ri] + c*twfm.wx    [ri])/(d*dh^e)))
  twp:addcol("wx_vs_k1d_fd"    , \ri -> ((a*twdp.wx    [ri] + b*twp.wx    [ri] + c*twdm.wx    [ri])/(d*dh^e)))
  twp:addcol("wxp_vs_k1f_fd"   , \ri -> ((a*twfp.phix  [ri] + b*twp.phix  [ri] + c*twfm.phix  [ri])/(d*dh^e)))
  twp:addcol("wxp_vs_k1d_fd"   , \ri -> ((a*twdp.phix  [ri] + b*twp.phix  [ri] + c*twdm.phix  [ri])/(d*dh^e)))
  twp:addcol("wy_vs_k1f_fd"    , \ri -> ((a*twfp.wy    [ri] + b*twp.wy    [ri] + c*twfm.wy    [ri])/(d*dh^e)))
  twp:addcol("wy_vs_k1d_fd"    , \ri -> ((a*twdp.wy    [ri] + b*twp.wy    [ri] + c*twdm.wy    [ri])/(d*dh^e)))
  twp:addcol("wyp_vs_k1f_fd"   , \ri -> ((a*twfp.phiy  [ri] + b*twp.phiy  [ri] + c*twfm.phiy  [ri])/(d*dh^e)))
  twp:addcol("wyp_vs_k1d_fd"   , \ri -> ((a*twdp.phiy  [ri] + b*twp.phiy  [ri] + c*twdm.phiy  [ri])/(d*dh^e)))
end
end

-- Build plots ------------------------

do
  twp:addcol("beta11_vs_k1f_dif", \ri -> twp.beta11_vs_k1f_da[ri] - twp.beta11_vs_k1f_fd[ri])
  twp:addcol("beta11_vs_k1d_dif", \ri -> twp.beta11_vs_k1d_da[ri] - twp.beta11_vs_k1d_fd[ri])
  twp:addcol("beta22_vs_k1f_dif", \ri -> twp.beta22_vs_k1f_da[ri] - twp.beta22_vs_k1f_fd[ri])
  twp:addcol("beta22_vs_k1d_dif", \ri -> twp.beta22_vs_k1d_da[ri] - twp.beta22_vs_k1d_fd[ri])
  twp:addcol("alfa11_vs_k1f_dif", \ri -> twp.alfa11_vs_k1f_da[ri] - twp.alfa11_vs_k1f_fd[ri])
  twp:addcol("alfa11_vs_k1d_dif", \ri -> twp.alfa11_vs_k1d_da[ri] - twp.alfa11_vs_k1d_fd[ri])
  twp:addcol("alfa22_vs_k1f_dif", \ri -> twp.alfa22_vs_k1f_da[ri] - twp.alfa22_vs_k1f_fd[ri])
  twp:addcol("alfa22_vs_k1d_dif", \ri -> twp.alfa22_vs_k1d_da[ri] - twp.alfa22_vs_k1d_fd[ri])
  twp:addcol("gama11_vs_k1f_dif", \ri -> twp.gama11_vs_k1f_da[ri] - twp.gama11_vs_k1f_fd[ri])
  twp:addcol("gama11_vs_k1d_dif", \ri -> twp.gama11_vs_k1d_da[ri] - twp.gama11_vs_k1d_fd[ri])
  twp:addcol("gama22_vs_k1f_dif", \ri -> twp.gama22_vs_k1f_da[ri] - twp.gama22_vs_k1f_fd[ri])
  twp:addcol("gama22_vs_k1d_dif", \ri -> twp.gama22_vs_k1d_da[ri] - twp.gama22_vs_k1d_fd[ri])
  twp:addcol("mu1_vs_k1f_dif"   , \ri -> twp.mu1_vs_k1f_da   [ri] - twp.mu1_vs_k1f_fd   [ri])
  twp:addcol("mu1_vs_k1d_dif"   , \ri -> twp.mu1_vs_k1d_da   [ri] - twp.mu1_vs_k1d_fd   [ri])
  twp:addcol("mu2_vs_k1f_dif"   , \ri -> twp.mu2_vs_k1f_da   [ri] - twp.mu2_vs_k1f_fd   [ri])
  twp:addcol("mu2_vs_k1d_dif"   , \ri -> twp.mu2_vs_k1d_da   [ri] - twp.mu2_vs_k1d_fd   [ri])
  twp:addcol("dx_vs_k1f_dif"    , \ri -> twp.dx_vs_k1f_da    [ri] - twp.dx_vs_k1f_fd    [ri])
  twp:addcol("dx_vs_k1d_dif"    , \ri -> twp.dx_vs_k1d_da    [ri] - twp.dx_vs_k1d_fd    [ri])
  twp:addcol("dpx_vs_k1f_dif"   , \ri -> twp.dpx_vs_k1f_da   [ri] - twp.dpx_vs_k1f_fd   [ri])
  twp:addcol("dpx_vs_k1d_dif"   , \ri -> twp.dpx_vs_k1d_da   [ri] - twp.dpx_vs_k1d_fd   [ri])
  twp:addcol("dy_vs_k1f_dif"    , \ri -> twp.dy_vs_k1f_da    [ri] - twp.dy_vs_k1f_fd    [ri])
  twp:addcol("dy_vs_k1d_dif"    , \ri -> twp.dy_vs_k1d_da    [ri] - twp.dy_vs_k1d_fd    [ri])
  twp:addcol("dpy_vs_k1f_dif"   , \ri -> twp.dpy_vs_k1f_da   [ri] - twp.dpy_vs_k1f_fd   [ri])
  twp:addcol("dpy_vs_k1d_dif"   , \ri -> twp.dpy_vs_k1d_da   [ri] - twp.dpy_vs_k1d_fd   [ri])
if chrm then
  twp:addcol("dmu1_vs_k1f_dif"  , \ri -> twp.dmu1_vs_k1f_da  [ri] - twp.dmu1_vs_k1f_fd  [ri])
  twp:addcol("dmu1_vs_k1d_dif"  , \ri -> twp.dmu1_vs_k1d_da  [ri] - twp.dmu1_vs_k1d_fd  [ri])
  twp:addcol("dmu2_vs_k1f_dif"  , \ri -> twp.dmu2_vs_k1f_da  [ri] - twp.dmu2_vs_k1f_fd  [ri])
  twp:addcol("dmu2_vs_k1d_dif"  , \ri -> twp.dmu2_vs_k1d_da  [ri] - twp.dmu2_vs_k1d_fd  [ri])
  twp:addcol("wx_vs_k1f_dif"    , \ri -> twp.wx_vs_k1f_da    [ri] - twp.wx_vs_k1f_fd    [ri])
  twp:addcol("wx_vs_k1d_dif"    , \ri -> twp.wx_vs_k1d_da    [ri] - twp.wx_vs_k1d_fd    [ri])
  twp:addcol("wxp_vs_k1f_dif"   , \ri -> twp.wxp_vs_k1f_da   [ri] - twp.wxp_vs_k1f_fd   [ri])
  twp:addcol("wxp_vs_k1d_dif"   , \ri -> twp.wxp_vs_k1d_da   [ri] - twp.wxp_vs_k1d_fd   [ri])
  twp:addcol("wy_vs_k1f_dif"    , \ri -> twp.wy_vs_k1f_da    [ri] - twp.wy_vs_k1f_fd    [ri])
  twp:addcol("wy_vs_k1d_dif"    , \ri -> twp.wy_vs_k1d_da    [ri] - twp.wy_vs_k1d_fd    [ri])
  twp:addcol("wyp_vs_k1f_dif"   , \ri -> twp.wyp_vs_k1f_da   [ri] - twp.wyp_vs_k1f_fd   [ri])
  twp:addcol("wyp_vs_k1d_dif"   , \ri -> twp.wyp_vs_k1d_da   [ri] - twp.wyp_vs_k1d_fd   [ri])
end
end

-- debug bet
twp:write("twiss_prms_bet_"..MAD.env.version..".tfs",
          {'name','kind','s',"beta11_vs_k1f_dif", "beta11_vs_k1f_da", "beta11_vs_k1f_fd"})

-- save table
twp:write("twiss_prms_"..MAD.env.version..".tfs")

io.write("Making plots...\n")

plot {
  title    = "beta vs da (order "..ord..")",  -- plot title
