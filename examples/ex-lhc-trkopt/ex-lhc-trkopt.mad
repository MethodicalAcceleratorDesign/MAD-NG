-- Script Setup
local seqs = {"lhcb1","lhcb2"}     -- list of sequences
local reft = true                  -- compute reference track & twiss
local knbs = true                 -- check tunes knobs effectiveness
local chrm = true                 -- compute chromatic functions
local cplg = true                  -- compute coupling  functions
local omdp = true                 -- use some off momentum dp
local cmap = true                 -- use cmaps (or not)
local save = true                  -- save (big) Twiss table
local mord = {1,2}                 -- max prms loop order (1 or 2)
local tplt = false                 -- plot title default: false or ""
local fplt = "ex-lhc-trkopt_"..MAD.env.version..".pdf" -- file to output plots

local fd = {1e-6, 1e-4} -- {5e-6, 5e-4} -- finite difference step size for each mord
local dp = 1e-3         -- delta_p value
local cr = 5e-4         -- C- real value
local ci = 5e-4         -- C- imag value
local po = mord[#mord]  -- prms max order

-- Import commands
local beam, track, twiss, damap, plot, option in MAD
-- Import utility functions
local printf, timeit, tblncat, tbl2str in MAD.utility

local cabs, carg in MAD.gmath

-- LHC Setup -------------------------------------------------------------------

local pbtop=beam{particle="proton", energy=6800}

MADX.option.warn=false
MADX:load("2024_lhcb1_saved.seq", "lhcb1.mad") -- convert and save on need
MADX:load("2024_lhcb2_saved.seq", "lhcb2.mad")
MADX:load("lhc_var0.mad")
MADX.option.warn=true

local lhcb1, lhcb2 in MADX
lhcb1.beam = pbtop
lhcb2.beam = pbtop
lhcb2.dir  = -1 -- reverse direction

-- sequence
for idx,snam in ipairs(seqs) do

io.write("Running ", snam, "\n")

-- sequence, tune knobs and coupling knobs
local seq = MADX[snam]
local bn  = ({"b1","b2"})[idx]
local dqx = "dqx_" ..bn.."_op"
local dqy = "dqy_" ..bn.."_op"
local dcr = "cmrs_"..bn.."_op"
local dci = "cmis_"..bn.."_op"

-- Reference Track & Twiss -----------------------------------------------------

local tk, tw

if reft or knbs then

local cols = {'name','kind','s','l','id','x','px','y','py','t','pt'}

-- Compute the reference track
tk = timeit(\ -> track {sequence=seq, observe=0, mapdef=1, cmap=cmap}, "Track Ref")
tk:write(snam.."_tk_ref.tfs", cols)

-- Compute the reference twiss
tw = timeit(\ -> twiss {sequence=seq, cmap=cmap}, "Twiss Ref")
tw:write(snam.."_tw_ref.tfs", cols)

plot {
  title   = tplt or "Optical Functions "..snam,     -- plot title
  table   = tw,                                     -- twiss table for plot
  xrange  = {0, seq.l},                             -- x range
  x1y1    = {s = {"beta11", "beta22", "dx", "dy"}}, -- x vs y1 columns
  x1y2    = {s = {"mu1", "mu2"}},                   -- x vs y2 columns
  xlabel  = "s [m]"   ,                             -- x-axis label
  ylabel  = "β_{x,y} [m], D_{x,y} [m]",             -- y-axis label left
  y2label = "μ_{x,y} [rad/2π]",                     -- y-axis label right
  legend  = {beta11="β_x", beta22="β_y",            -- column labels
             mu1="μ_x", mu2="μ_y",                  --   idem
             dx="D_x", dy="D_y"},                   --   idem
  styles  = "lines", linewidth=1.5, fontsize=16,    -- styles
  output   = fplt,
}

end -- ref

-- check knobs consistency
if knbs then

local shft = 0.01

printf(" q1               = %10.7f\n",  tw.q1)
printf(" q2               = %10.7f\n",  tw.q2)

MADX[dqx] = shft
MADX[dqy] = 0
local twd = timeit(\ -> twiss {sequence=seq, observe=1, cmap=cmap}, "Twiss Chk")
printf(" q1_dqx           = %10.7f\n",  twd.q1)
printf(" q2_dqx           = %10.7f\n",  twd.q2)
printf("(q1_dqx-q1)/shft  = %10.7f\n", (twd.q1-tw.q1)/shft)
printf("(q2_dqx-q2)/shft  = %10.7f\n", (twd.q2-tw.q2)/shft)

MADX[dqx] = 0
MADX[dqy] = shft
local twd = timeit(\ -> twiss {sequence=seq, observe=1, cmap=cmap}, "Twiss Chk")
printf(" q1_dqy           = %10.7f\n",  twd.q1)
printf(" q2_dqy           = %10.7f\n",  twd.q2)
printf("(q1_dqy-q1)/shft  = %10.7f\n", (twd.q1-tw.q1)/shft)
printf("(q2_dqy-q2)/shft  = %10.7f\n", (twd.q2-tw.q2)/shft)

MADX[dqx] = shft
MADX[dqy] = shft
local twd = timeit(\ -> twiss {sequence=seq, observe=1, cmap=cmap}, "Twiss Chk")
printf(" q1_dqxy          = %10.7f\n",  twd.q1)
printf(" q2_dqxy          = %10.7f\n",  twd.q2)
printf("(q1_dqxy-q1)/shft = %10.7f\n", (twd.q1-tw.q1)/shft)
printf("(q2_dqxy-q2)/shft = %10.7f\n", (twd.q2-tw.q2)/shft)

end -- knbs

--[[
MAD-X LHCB1, shft=0.01         ; MAD-NG LHCB1, shft=0.01
q1                = 62.3100002 ;  q1               = 62.3100000
q2                = 60.3200000 ;  q2               = 60.3200000
q1_dqx            = 62.3200013 ;  q1_dqx           = 62.3200011
q2_dqx            = 60.3200007 ;  q2_dqx           = 60.3200007
(q1_dqx-q1)/shft  =  1.0001094 ; (q1_dqx-q1)/shft  =  1.0001105
(q2_dqx-q2)/shft  =  0.0000699 ; (q2_dqx-q2)/shft  =  0.0000701
q1_dqy            = 62.3100009 ;  q1_dqy           = 62.3100007
q2_dqy            = 60.3300011 ;  q2_dqy           = 60.3300011
(q1_dqy-q1)/shft  =  0.0000705 ; (q1_dqy-q1)/shft  =  0.0000705
(q2_dqy-q2)/shft  =  1.0001113 ; (q2_dqy-q2)/shft  =  1.0001113
q1_dqxy           = 62.3200061 ;  q1_dqxy          = 62.3200059
q2_dqxy           = 60.3300059 ;  q2_dqxy          = 60.3300059
(q1_dqxy-q1)/shft =  1.0005908 ; (q1_dqxy-q1)/shft =  1.0005919
(q2_dqxy-q2)/shft =  1.0005918 ; (q2_dqxy-q2)/shft =  1.0005921
                               ;
MAD-X LHCB2, shft=0.01         ; MAD-NG LHCB2, shft=0.01
q1                = 62.3100004 ;  q1               = 62.3100000
q2                = 60.3200000 ;  q2               = 60.3200000
q1_dqx            = 62.3200015 ;  q1_dqx           = 62.3200011
q2_dqx            = 60.3200007 ;  q2_dqx           = 60.3200007
(q1_dqx-q1)/shft  =  1.0001122 ; (q1_dqx-q1)/shft  =  1.0001135
(q2_dqx-q2)/shft  =  0.0000705 ; (q2_dqx-q2)/shft  =  0.0000707
q1_dqy            = 62.3100011 ;  q1_dqy           = 62.3100007
q2_dqy            = 60.3300007 ;  q2_dqy           = 60.3300007
(q1_dqy-q1)/shft  =  0.0000710 ; (q1_dqy-q1)/shft  =  0.0000710
(q2_dqy-q2)/shft  =  1.0000691 ; (q2_dqy-q2)/shft  =  1.0000691
q1_dqxy           = 62.3200063 ;  q1_dqxy          = 62.3200060
q2_dqxy           = 60.3300055 ;  q2_dqxy          = 60.3300054
(q1_dqxy-q1)/shft =  1.0005956 ; (q1_dqxy-q1)/shft =  1.0005969
(q2_dqxy-q2)/shft =  1.0005418 ; (q2_dqxy-q2)/shft =  1.0005420
--]]

-- First and Second derivative check -------------------------------------------

-- Trkopt setup
local knbs = {
  ["1000"] = "dqx", ["0100"] = "dqy", ["0010"] = "dcr", ["0001"] = "dci",
  ["2000"] = "dqx", ["0200"] = "dqy", ["0020"] = "dcr", ["0002"] = "dci",
}

local kord = {
  ["1000"] = 1, ["0100"] = 1, ["0010"] = 1, ["0001"] = 1,
  ["2000"] = 2, ["0200"] = 2, ["0020"] = 2, ["0002"] = 2,
}

local kmon = tblncat(            {"1000", "0100"},
             not cplg  and {} or {"0010", "0001"},
   po < 2              and {} or {"2000", "0200"},
  (po < 2 or not cplg) and {} or {"0020", "0002"})

local kopt = tblncat(
  {"beta11", "beta22",
   "beta12", "beta21",
   "alfa11", "alfa22",
   "alfa12", "alfa21",
   "gama11", "gama22",
   "gama12", "gama21",
      "mu1",    "mu2",
       "dx",    "dpx",
       "dy",    "dpy"},
  not chrm and {} or
  {  "dmu1",   "dmu2",
       "wx",     "wy",
      "wxp",    "wyp"},
  not cplg and {} or
  {  "betx",   "bety",
     "alfx",   "alfy",
      "r11",    "r12",
      "r21",    "r22",
    "f1010",  "f1001",
      "ev1",    "ev2"})

local kopts, k = {}, 1
for i=1,#kopt,2 do
for j=1,#kmon,2 do
  kopts[k], k = kopt[i+0].."_"..kmon[j+0], k+1
  kopts[k], k = kopt[i+0].."_"..kmon[j+1], k+1
  kopts[k], k = kopt[i+1].."_"..kmon[j+0], k+1
  kopts[k], k = kopt[i+1].."_"..kmon[j+1], k+1
end end

-- Coupling setup
if cplg then
print("before:", dcr.."=", MADX[dcr], dci.."=", MADX[dci])
  MADX[dcr] = MADX[dcr] + cr
  MADX[dci] = MADX[dci] + ci
  io.write("Setting coupling knob C- = (", MADX[dcr], ",", MADX[dci], ")\n")
print("after:", dcr.."=", MADX[dcr], dci.."=", MADX[dci])
end

-- Delta_p setup
if omdp then
  io.write("Setting off momentum deltap = ", dp, "\n")
else dp = nil end

-- twiss setup (template)
local twcmd = twiss {sequence=seq, deltap=dp, chrom=chrm, coupling=cplg,
                     cmap=cmap, exec=false}

-- Compute parametric twiss -----------

io.write("Computing parametric Twiss for ", snam, "\n")

local mo = po+(chrm and 2 or 1)
local pn = cplg and {"dqx","dqy","dcr","dci"} or {"dqx","dqy"}
local x0 = damap {nv=6, np=#pn, no={mo,mo,mo,mo,1,1}, po=po, pn=pn}

MADX[dqx] = MADX[dqx] + x0.dqx
MADX[dqy] = MADX[dqy] + x0.dqy
if cplg then
MADX[dcr] = MADX[dcr] + x0.dcr
MADX[dci] = MADX[dci] + x0.dci
end

local twp = timeit(\ -> twcmd {X0=x0, trkopt=kopts}, "Twiss DA")

MADX[dqx] = MADX[dqx]:get0()
MADX[dqy] = MADX[dqy]:get0()
if cplg then
MADX[dcr] = MADX[dcr]:get0()
MADX[dci] = MADX[dci]:get0()
end

-- MAD._C.mad_tpsa_divc_getcnt(nil,nil)

-- Add DA columns to twp
for idx, key in ipairs(kopts) do
  local fct, mon = key:sub(1,-6), key:sub(-4,-1)
  local knb, ord = assert(knbs[mon]), assert(kord[mon])
  local col_da = fct.."_vs_"..knb.."_da"..ord
  printf("%12s:  %6s  %4s  %3s  %d  %17s\n",
          key, fct, mon, knb, ord, col_da)
  twp:addcol(col_da, \ri -> twp[key][ri])
end

-- Compute finite difference twiss ----

io.write("Computing finite difference Twiss for ", snam, "\n")

-- Loop over orders -------------------
for _,po in ipairs(mord) do

io.write("Computing order ", po, " for ", snam, "\n")

local dh  = fd[po] -- finite differences step
local twd = {dqx={},dqy={}}

-- twiss with dqx as dh
MADX[dqx] = MADX[dqx] + dh
twd.dqx.p = timeit(\ -> twcmd {}, "Twiss FD dqx+dh")
MADX[dqx] = MADX[dqx] - dh*2
twd.dqx.m = timeit(\ -> twcmd {}, "Twiss FD dqx-dh")
MADX[dqx] = MADX[dqx] + dh

-- twiss with dqy as dh
MADX[dqy] = MADX[dqy] + dh
twd.dqy.p = timeit(\ -> twcmd {}, "Twiss FD dqy+dh")
MADX[dqy] = MADX[dqy] - dh*2
twd.dqy.m = timeit(\ -> twcmd {}, "Twiss FD dqy-dh")
MADX[dqy] = MADX[dqy] + dh

if cplg then
twd.dcr, twd.dci = {},{}
-- twiss with dcr as dh
MADX[dcr] = MADX[dcr] + dh
twd.dcr.p = timeit(\ -> twcmd {}, "Twiss FD dcr+dh")
MADX[dcr] = MADX[dcr] - dh*2
twd.dcr.m = timeit(\ -> twcmd {}, "Twiss FD dcr-dh")
MADX[dcr] = MADX[dcr] + dh

-- twiss with dci as dh
MADX[dci] = MADX[dci] + dh
twd.dci.p = timeit(\ -> twcmd {}, "Twiss FD dci+dh")
MADX[dci] = MADX[dci] - dh*2
twd.dci.m = timeit(\ -> twcmd {}, "Twiss FD dci-dh")
MADX[dci] = MADX[dci] + dh
end

-- Add FD and DF columns to twp
do
  local a,b,c,d,e in ({
    { a=1, b= 0, c=-1, d=2, e=1 },
    { a=1, b=-2, c= 1, d=1, e=2 },
  })[po]

  for _, key in ipairs(kopts) do
    local fct, mon = key:sub(1,-6), key:sub(-4,-1)
    local knb, ord = assert(knbs[mon]), assert(kord[mon])
    if ord == po then
      local col_da = fct.."_vs_"..knb.."_da"..ord
      local col_fd = fct.."_vs_"..knb.."_fd"..ord
      local col_df = fct.."_vs_"..knb.."_df"..ord
    printf("%12s:  %6s  %4s  %3s  %d  %17s  %17s  %17s\n",
            key, fct, mon, knb, ord, col_da, col_fd, col_df)
      twp:addcol(col_fd, \ri -> ((a*twd[knb].p[fct][ri] + b*twp[fct][ri] + c*twd[knb].m[fct][ri])/(d*dh^e)))
      twp:addcol(col_df, \ri -> twp[col_da][ri] - twp[col_fd][ri])
    end
  end
end

end -- loop over mord

-- Save data ------------------------

if save then
  io.write("Saving TFS table...\n")
  local cols = {'name', 'kind', 's', 'l', 'betx_vs_dci_da1', 'betx_vs_dci_fd1', 'betx_vs_dci_df1', 'betx_vs_dci_da2', 'betx_vs_dci_fd2', 'betx_vs_dci_df2'}
  twp:write("twiss_prms_"..snam.."-"..MAD.env.version..".tfs", cols) --, tblncat(cols, funs))
end

-- Build plots ------------------------

-- Template --------

local plt = plot { -- plot template
  table  = twp,
  styles = "lines", linewidth=1.5, fontsize=16,
  output = fplt,
  prolog = "set key noenhanced",
  exec   = false
}

-- Make plots

io.write("Making plots...\n")
assert(#kopts % 4 == 0)

for i=1,#kopts,4 do
  local lst_da, lst_fd, lst_df, ord = {}, {}, {}
  for j=1,4 do
    local key = kopts[i+j-1]
    local fct, mon = key:sub(1,-6), key:sub(-4,-1)
    local knb = assert(knbs[mon]) ; ord = assert(kord[mon])
    lst_da[j] = fct.."_vs_"..knb.."_da"..ord
    lst_fd[j] = fct.."_vs_"..knb.."_fd"..ord
    lst_df[j] = fct.."_vs_"..knb.."_df"..ord
  end
  io.write("Plotting ", tbl2str(lst_da), "\n")
  plt {
    title = tplt or "Sensitivity from DA ("..snam..", order "..ord..")",
    x1y1  = {s=lst_da},
  }
  io.write("Plotting ", tbl2str(lst_fd), "\n")
  plt {
    title = tplt or "Sensitivity from FD ("..snam..", order "..ord..")",
    x1y1  = {s=lst_fd},
  }
  io.write("Plotting ", tbl2str(lst_df), "\n")
  plt {
    title = tplt or "Sensitivity error DA-FD ("..snam..", order "..ord..")",
    x1y1  = {s=lst_df},
  }
end

end -- loop over seq
