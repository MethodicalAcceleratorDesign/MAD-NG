local beam, twiss, plot, mtable in MAD
local abs, sign in MAD.gmath

MADX:load("Z_sequence.seq", "fcc_ee_z.mad") -- convert and save on need
local seq = MADX.fccee_p_ring

-- attach beam
MAD.option.nocharge = true
seq.beam = beam {particle="electron", energy=45.6}

seq:dumpseq"dumpseq.txt"

-- setup
seq['Q_SF.0L2'].k1s = 1e-5


local twcol = {'name','s','x','y','beta11','beta22','betx','bety','alfx','alfy','r11','r12','r21','r22', 'f1010', 'f1001'}

local tw = twiss { sequence=seq, coupling=true } :write("twiss_ng.tfs", twcol)

local rng = {0,500} -- {45560,45620}

local twx = mtable:read"twiss_x.tfs"

print(#tw, #twx)

tw:addcol("BETX", \i -> i > 1000 and 0 or twx.BETX[i])
tw:addcol("BETY", \i -> i > 1000 and 0 or twx.BETY[i])
tw:addcol("ALFX", \i -> i > 1000 and 0 or twx.ALFX[i])
tw:addcol("ALFY", \i -> i > 1000 and 0 or twx.ALFY[i])
tw:addcol("R11" , \i -> i > 1000 and 0 or twx.R11[i])
tw:addcol("R12" , \i -> i > 1000 and 0 or twx.R12[i])
tw:addcol("R21" , \i -> i > 1000 and 0 or twx.R21[i])
tw:addcol("R22" , \i -> i > 1000 and 0 or twx.R22[i])

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "B",
       x1y1 = { s={'betx','bety','BETX','BETY'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "B",
       x1y1 = { s={'alfx','alfy','ALFX','ALFY'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "R",
       x1y1 = { s={'r11','r12','r21','r22'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "R",
       x1y1 = { s={'R11','R12','R21','R22'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "R",
       x1y1 = { s={'r11', 'R11'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "R",
       x1y1 = { s={'r12', 'R12'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "R",
       x1y1 = { s={'r21', 'R21'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Rmatrix ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "R",
       x1y1 = { s={'r22', 'R22'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}

plot { table=tw, sequence=seq,
       title="Linear RDTs ("..seq.name..")",
       xlabel = "s [m]", xrange=rng,
       ylabel = "f_{ijkl}",
       x1y1 = { s={'f1010', 'f1001'} },
       styles = 'lines',
       output = "twiss_ng.pdf",
}
