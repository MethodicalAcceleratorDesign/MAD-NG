call, file="fodo.seq";

beam;
use, sequence=seq;
select, flag=twiss, column={name, s, betx, bety, mux, muy, alfx, alfy};
twiss, file="twiss_x.tfs";

Qx = table(summ, q1);
Qy = table(summ, q2);
Qxd = Qx + 0.02;
Qyd = Qy - 0.03;

betxac=table(twiss, M1, BEAM, betx);
betyac=table(twiss, M1, BEAM, bety);

hacmap21=2*(cos(2*pi*Qxd)-cos(2*pi*Qx))/(betxac*sin(2*pi*Qx));
vacmap43=2*(cos(2*pi*Qyd)-cos(2*pi*Qy))/(betyac*sin(2*pi*Qy));

hacmap: matrix, l=0, rm21=hacmap21;
vacmap: matrix, l=0, rm43=vacmap43;

seqedit, sequence=seq;
    flatten;
    install, element=hacmap, at=0, from=M1;
    install, element=vacmap, at=0, from=M1;
endedit;

use, sequence=seq;
twiss, file="twiss_acd_x.tfs";

seqedit, sequence=seq;
    flatten;
    remove, element=hacmap;
    remove, element=vacmap;
endedit;

r1 = 1.0;
r2 = 3.0;
r3 = 5.0;
r4 = 7.0;

hacd: hacdipole, l=0, freq=Qxd, lag=0.02,
    volt=0.01,
    ramp1=r1, ramp2=r2, ramp3=r3, ramp4=r4;
vacd: vacdipole, l=0, freq=Qyd, lag=0.03,
    volt=0.01,
    ramp1=r1, ramp2=r2, ramp3=r3, ramp4=r4;

seqedit, sequence=seq;
    flatten;
    install, element=hacd, at=0.0, from=M1;
    install, element=vacd, at=0.0, from=M1;
endedit;

use, sequence=seq;
track, onetable=true, file="track_acd.";
start;
observe, place=#s;
observe, place=M1;
run, turns=10;
endtrack;