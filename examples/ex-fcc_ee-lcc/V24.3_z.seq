! A perfect eight-fold symmetry ring with 8 RF stations
! RING_U: LINE=( 28*CELL_U, RFC, 28*CELL_U, RFC, 28*CELL_U, RFC, 28*CELL_U, RFC, 28*CELL_U, RFC, 28*CELL_U, RFC, 28*CELL_U, RFC, 28*CELL_U, RFC );

