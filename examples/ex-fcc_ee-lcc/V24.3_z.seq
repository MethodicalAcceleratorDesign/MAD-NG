! ARC_SUFR:  LINE=( -STRAIGHT_R, -CELL_SU, -CELL_UR, ARC_OCTANT, CELL_R3, CELL_UFFR, FFR ); MARC_SUFR: LINE=(-ARC_SUFR);
! ARC_SUDSL: LINE=( -STRAIGHT_L, -CELL_US, -CELL_UL, ARC_OCTANT, CELL_L3, CELL_UFFL );
