ARC_OCTANT: LINE=( 25*CELL_U );

FCCEE_P_RING: LINE = (4 * (-CCS_YR, -CCS_XR, -CELL_UFFR, -CELL_R3,
	            -ARC_OCTANT,
		    CELL_UR,  CELL_SU, STRAIGHT_R, -STRAIGHT_L, -CELL_US, -CELL_UL,
		    ARC_OCTANT,
		    CELL_L3, CELL_UFFL, CCS_XL, CCS_YL ));


