QF2L:  MQINSS, K1:=KQF02L;  QF2R:  MQINSS, K1:=KQF02R;
QD1L:  MQINSS, K1:=KQD01L;  QD1R:  MQINSS, K1:=KQD01R;

! Superconducting final focusing quadrupoles

MQF1: QUADRUPOLE, L=1.50;
MQD0: QUADRUPOLE, L=1.75;

