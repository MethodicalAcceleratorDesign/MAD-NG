QF15L: MQINSL, K1:=KQF15L;  QF15R: MQINSM, K1:=KQF15R;
QD14L: MQINSM, K1:=KQD14L;  QD14R: MQINSM, K1:=KQD14R;
QF13L: MQINSS, K1:=KQF13L;  QF13R: MQINSS, K1:=KQF13R;
QF12L: MQINSS, K1:=KQF12L;  QF12R: MQINSS, K1:=KQF12R;
QD11L: MQINSM, K1:=KQD11L;  QD11R: MQINSM, K1:=KQD11R;
QF10L: MQINSM, K1:=KQF10L;  QF10R: MQINSM, K1:=KQF10R;
QD9L:  MQINSS, K1:=KQD09L;  QD9R:  MQINSS, K1:=KQD09R;
QF8L:  MQINSM, K1:=KQF08L;  QF8R:  MQINSM, K1:=KQF08R;
QD7L:  MQINSS, K1:=KQD07L;  QD7R:  MQINSM, K1:=KQD07R;
QD6L:  MQINSS, K1:=KQD06L;  QD6R:  MQINSM, K1:=KQD06R;
QF5L:  MQINSM, K1:=KQF05L;  QF5R:  MQINSM, K1:=KQF05R;
QD4L:  MQINSS, K1:=KQD04L;  QD4R:  MQINSM, K1:=KQD04R;
