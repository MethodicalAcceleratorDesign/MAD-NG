CELL_UL: LINE=(QD1A, DR_01, DL1A, DR_01, QF2A, DR_01,
               SF2A, DR_01, DL2A, DR_01,   SD1A,   DR_01, QD3A, DR_01, DL2A, DR_01,   SF1A,  DR_01, QF4A, DR_01, DL2A, DR_01, SD2A,
	       DR_01, QD5A, DR_01, DL3A, DR_01,   QF6A,   DR_01, DL3A, DR_01, QD5A, DR_01,
	       SD2AUL, DR_01, DL2A, DR_01, QF4A, DR_01, SF1AUL, DR_01, DL2A, DR_01, QD3A, DR_01, SD1AUL, DR_01, DL2A, DR_01, SF2AUL,
	       DR_01, QF2A, DR_01, DL1A, DR_01, QD1A);

! CELL with SF2A, SD1A, SF1A, SD2A families on one side and SD2AUR, SF1AUR, SD1AUR, SF2AUR on the other side
CELL_UR: LINE=(QD1A, DR_01, DL1A, DR_01, QF2A, DR_01,
	       SF2A, DR_01, DL2A, DR_01, SD1A, DR_01, QD3A, DR_01, DL2A, DR_01, SF1A, DR_01, QF4A, DR_01, DL2A, DR_01, SD2A,
	       DR_01, QD5A, DR_01, DL3A, DR_01,   QF6A,   DR_01, DL3A, DR_01, QD5A, DR_01,
	       SD2AUR, DR_01, DL2A, DR_01, QF4A, DR_01, SF1AUR, DR_01, DL2A, DR_01, QD3A, DR_01, SD1AUR, DR_01, DL2A, DR_01, SF2AUR,
	       DR_01, QF2A, DR_01, DL1A, DR_01, QD1A);

