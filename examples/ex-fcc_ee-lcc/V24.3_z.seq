! Main parameters (Should be moved to calling file)

E0 = 45.6; ! Z pole
THETA_CROSS = 0.03; ! Full crossing angle of 30 mrad

! Switches (should be moved to calling file)

DOGLEG_ON = 0;
CS_FRAC   = 0.8;
CS_COMP   = 0.4;
SXT_ON    = 1;
RF_ON     = 1;

!! Definition of elements (should be a separate file)

! RF Acceleration (crude model)

RF_VOLTAGE := 50.0*RF_ON;
RFC: RFCAVITY, L=1.E-12, VOLT:=RF_VOLTAGE, LAG=0.4, HARMON=121200;

! Markers

SCENTER: MARKER;
IP:      MARKER; IPIMAG2: MARKER; IPIMAG4: MARKER;

! Generic drifts 
LX0:   DRIFT, L= 0.15; ! inter element space 

! Specific drifts
LSTAR: DRIFT,  L= 2.2;  ! space between final focusing quadrupole and the IP
LXS:   DRIFT,  L= 0.15; ! space between final focusing quadrupole QF and QD
D2R:   DRIFT,  L=17.1;  ! space between final doublet and next quadrupole
D2L:   DRIFT,  L=17.1;  ! space between final doublet and next quadrupole

D8L: DRIFT, L= 7.0;     ! space in CCS-X
D8R: DRIFT, L=60.5065;  ! space in CCS-X


! Arc Dipoles

DL_LEN = 28.94695; ! base for dipole length

BXFR  =  0.03695179;
BYFR  = -0.3034615E-2;
BXYFF := 1 + BXFR/3 - BYFR/6;

ADF1 = 0.4;
ANG_RESCALING_DS := 1 + 32*ADF1*BXYFF/224/10;

FFLR_ANGLE = 0.107; ! ??

ANG0   := (2*PI - 4*FFLR_ANGLE)/224/10/ANG_RESCALING_DS;
DANG0  = 0;

B0FL = 0.3068;      B0FR = 1.0;
B1FL = 0.9467407;   B1FR := B0FR;	 
B3FL = 2.02;	    B3FR = 1.0;	 
B4FL = 0.7761993;   B4FR = 0.4177369;
B5FL = 3.622775;    B5FR = 1.222555; 
B6FL = 3.7217;	    B6FR = 1.4881;	 
B7FL = 3.146938;    B7FR = 0.8658736;


ANGTFL := FFLR_ANGLE*0.5 - THETA_CROSS*0.5 - DANG0;
ANGFFL := ANGTFL/(1*B0FL*0.76 + 2*B0FL*1.1 + 1*B0FL*1.38 + 1*B1FL*1.68 + 2*B3FL*0.71 + 1*B4FL*1.37 + 1*B4FL*0.98 + 1*B4FL*0.98 + 1*B5FL*0.8 + 2*B6FL*0.72 + 2*B7FL*0.72);
ANGTFR := FFLR_ANGLE*0.5 + THETA_CROSS*0.5 + DANG0;
ANGFFR := ANGTFR/(2*B0FR*0.451 + 1*B0FR*0.451 + 1*B1FR*0.546 + 1*B1FR*0.666 + 6*B3FR*0.665 + 2*B4FR*0.76 + 2*B5FR*0.84 + 2*B6FR*0.84 + 2*B7FR*0.84);
ANG_FF_RATIO := ANGTFR/ANGTFL;

ADS1 = 0.56; ADS2 = 0.56; ADS3 = 0.554;

DL1A: SBEND, L:=DL_LEN*(1 + BYFR),                         ANGLE:=ANG0*(1 + BYFR);
DL2A: SBEND, L:=DL_LEN*(1 - BYFR/3 - BXFR/3),              ANGLE:=ANG0*(1 - BYFR/3 - BXFR/3);
DL3A: SBEND, L:=DL_LEN*(1 + BXFR),                         ANGLE:=ANG0*(1 + BXFR);
DF2A: SBEND, L:=DL_LEN*(1 - BYFR/3 - BXFR/3)*(0.5 + ADF1), ANGLE:=ANG0*(1 - BYFR/3 - BXFR/3)*(0.5 + ADF1);
DF3A: SBEND, L:=DL_LEN*(1 + BXFR)           *(0.5 + ADF1), ANGLE:=ANG0*(1.0 + BXFR)*(0.5 + ADF1);
DS1A: SBEND, L:=DL_LEN*BXYFF*ADS1,                         ANGLE:=ANG0*BXYFF*ADS1;
DS2A: SBEND, L:=DL_LEN*BXYFF*ADS2,                         ANGLE:=ANG0*BXYFF*ADS2;
DS3A: SBEND, L:=DL_LEN*BXYFF*ADS3,                         ANGLE:=ANG0*BXYFF*ADS3;
DS4A: SBEND, L:=DL_LEN*BXYFF*(2.0 - ADS1 - ADS2 - ADS3),   ANGLE:=ANG0*BXYFF*(2.0 - ADS1 - ADS2 - ADS3);

DS_01: DRIFT, L:=DL_LEN*BXYFF*(1.0 - ADS1)*0.5;
DS_02: DRIFT, L:=DL_LEN*BXYFF*(1.0 - ADS2)*0.5;
DS_03: DRIFT, L:=DL_LEN*BXYFF*(1.0 - ADS3)*0.5;
DS_04: DRIFT, L:=DL_LEN*BXYFF*(ADS1 + ADS2 + ADS3 - 1.0)*0.5;

ANGS1L := -0.6251E-3 * DOGLEG_ON;
DS1L: SBEND, L=7.9, ANGLE:= ANGS1L;
DS1R: SBEND, L=7.9, ANGLE:=-ANGS1L;

DR_01:  DRIFT,  L= 0.15;
DL_00:  DRIFT,  L=47.0;
DL_04:  DRIFT,  L=59.369;
DL_01:  DRIFT,  L=75.0;
DL_01M: DRIFT,  L=75.0/2; ! half the DL_01 drift

DD56 = -0.4801018E-2;
DL_05: DRIFT, L := 66.9 - DD56;
DL_06: DRIFT, L :=  0.2 + DD56;

CLENGTH_ADJ = 1.467;
DL_02A: DRIFT, L := 7.0 + CLENGTH_ADJ/24;
DL_02B: DRIFT, L := 7.0 + CLENGTH_ADJ/24;
DL_02C: DRIFT, L := 7.0 + CLENGTH_ADJ/24;


! Arc Quadrupoles

MQD1: QUADRUPOLE, L=0.96*2;
MQD1H : QUADRUPOLE, L=0.96;
MQF2: QUADRUPOLE, L=2.39;
MQD3: QUADRUPOLE, L=1.86;
MQF4: QUADRUPOLE, L=2.40;
MQD5: QUADRUPOLE, L=1.83;
MQF6: QUADRUPOLE, L=2.37;

QD1A:  MQD1H, K1:=KQD1; ! Half a QD1 quadrupole at cell boundaries

QF2A:  MQF2, K1:=KQF2;
QFS0A: MQF2, K1:=KQFS0;
QFM0L: MQF2, K1:=KQFM0L; QFM0R: MQF2, K1:=KQFM0R;

QD3A:  MQD3, K1:=KQD3;
QDS0A: MQD3, K1:=KQDS0;
QDM0L: MQD3, K1:=KQDM0L; QDM0R: MQD3, K1:=KQDM0R;

QF4A:  MQF4, K1:=KQF4;
QFS1A: MQF4, K1:=KQFS1;
QFS5A: MQF4, K1:=KQFS5;
QFM1L: MQF4, K1:=KQFM1L; QFM1R: MQF4, K1:=KQFM1R; 
QFM5L: MQF4, K1:=KQFM5L; QFM5R: MQF4, K1:=KQFM5R;

QD5A:  MQD5, K1:=KQD5;
QDS2A: MQD5, K1:=KQDS2;
QDS4A: MQD5, K1:=KQDS4;

QDM2L: MQD5, K1:=KQDM2L; QDM2R: MQD5, K1:=KQDM2R;
QDM4L: MQD5, K1:=KQDM4L; QDM4R: MQD5, K1:=KQDM4R;
QDM6L: MQD5, K1:=KQDM6L; QDM6R: MQD5, K1:=KQDM6R;
QFM7L: MQD5, K1:=KQFM7L; QFM7R: MQD5, K1:=KQFM7R; 
QDM8L: MQD5, K1:=KQDM8L; QDM8R: MQD5, K1:=KQDM8R;

QF6A:  MQF6, K1:=KQF6;
QFS3A: MQF6, K1:=KQFS3;
QFM3L: MQF6, K1:=KQFM3L; QFM3R: MQF6, K1:=KQFM3R;

! Arc Sextupoles

MARCSF : SEXTUPOLE, L=0.30;
MARCSD : SEXTUPOLE, L=0.52;

SF1A:   MARCSF, K2:=KSF1; SF2A:   MARCSF, K2:=KSF2; SF3A:   MARCSF, K2:=KSF3; SF4A:   MARCSF, K2:=KSF4;
SD1A:   MARCSD, K2:=KSD1; SD2A:   MARCSD, K2:=KSD2; SD3A:   MARCSD, K2:=KSD3; SD4A:   MARCSD, K2:=KSD4;

SF1AUL: MARCSF, K2:=KSF1UL; SF2AUL: MARCSF, K2:=KSF2UL; SF1AUR: MARCSF, K2:=KSF1UR; SF2AUR: MARCSF, K2:=KSF2UR;
SF1ASL: MARCSF, K2:=KSF1SL; SF2ASL: MARCSF, K2:=KSF2SL; SF1ASR: MARCSF, K2:=KSF1SR; SF2ASR: MARCSF, K2:=KSF2SR;
SF3ASL: MARCSF, K2:=KSF3SL;                          SF3ASR: MARCSF, K2:=KSF3SR;
SD1AUL: MARCSD, K2:=KSD1UL; SD2AUL: MARCSD, K2:=KSD2UL; SD1AUR: MARCSD, K2:=KSD1UR; SD2AUR: MARCSD, K2:=KSD2UR;

SD1ASL: MARCSD, K2:=KSD1SL; SD2ASL: MARCSD, K2:=KSD2SL;
SD1ASR: MARCSD, K2:=KSD1SR; SD2ASR: MARCSD, K2:=KSD2SR;

SF1AFL: MARCSF, K2:=KSF1FL; SF2AFL: MARCSF, K2:=KSF2FL; SF1AFR: MARCSF, K2:=KSF1FR; SF2AFR: MARCSF, K2:=KSF2FR; SF3AFL: MARCSF, K2:=KSF3FL; SF3AFR: MARCSF, K2:=KSF3FR;
SD1AFL: MARCSD, K2:=KSD1FL; SD2AFL: MARCSD, K2:=KSD2FL; SD1AFR: MARCSD, K2:=KSD1FR; SD2AFR: MARCSD, K2:=KSD2FR;

! SF1AL2: MARCSF, K2:=KSF1AL2; SF2AL2: MARCSF, K2:=KSF2AL2; SF1BL2: MARCSF, K2:=KSF1BL2; SF2BL2: MARCSF, K2:=KSF2BL2;
! SF1AR2: MARCSF, K2:=KSF1AR2; SF2AR2: MARCSF, K2:=KSF2AR2; SF1BR2: MARCSF, K2:=KSF1BR2; SF2BR2: MARCSF, K2:=KSF2BR2;

SF1AL3: MARCSF, K2:=KSF1AL3; SF2AL3: MARCSF, K2:=KSF2AL3; SF1BL3: MARCSF, K2:=KSF1BL3; SF2BL3: MARCSF, K2:=KSF2BL3;
SF1AR3: MARCSF, K2:=KSF1AR3; SF2AR3: MARCSF, K2:=KSF2AR3; SF1BR3: MARCSF, K2:=KSF1BR3; SF2BR3: MARCSF, K2:=KSF2BR3;

! SD1AL2: MARCSD, K2:=KSD1AL2; SD2AL2: MARCSD, K2:=KSD2AL2; SD1BL2: MARCSD, K2:=KSD1BL2; SD2BL2: MARCSD, K2:=KSD2BL2;
! SD1AR2: MARCSD, K2:=KSD1AR2; SD2AR2: MARCSD, K2:=KSD2AR2; SD1BR2: MARCSD, K2:=KSD1BR2; SD2BR2: MARCSD, K2:=KSD2BR2;

SD1AL3: MARCSD, K2:=KSD1AL3; SD2AL3: MARCSD, K2:=KSD2AL3; SD1BL3: MARCSD, K2:=KSD1BL3; SD2BL3: MARCSD, K2:=KSD2BL3;
SD1AR3: MARCSD, K2:=KSD1AR3; SD2AR3: MARCSD, K2:=KSD2AR3; SD1BR3: MARCSD, K2:=KSD1BR3; SD2BR3: MARCSD, K2:=KSD2BR3;

! Crab Sextupoles

SCRAB: SEXTUPOLE, L=0.6/4; 
SCRABL: SCRAB, K2:=KCRABL; SCRABR: SCRAB, K2:=KCRABR;
L_SXTF = SCRAB->L;

! Insertion Dipoles

LBFL  = 55.88;
LBFR  = 61.95;

D7L: DRIFT, L := LBFL*0.72 + 0.3;

B7L:  RBEND, L := LBFL*0.72, ANGLE := ANGFFL*B7FL*0.72;
B6L:  RBEND, L := LBFL*0.72, ANGLE := ANGFFL*B6FL*0.72;
B5L:  RBEND, L := LBFL*0.8,  ANGLE := ANGFFL*B5FL*0.8;
B4LC: RBEND, L := LBFL*0.98, ANGLE := ANGFFL*B4FL*0.98;
B4LB: RBEND, L := LBFL*0.98, ANGLE := ANGFFL*B4FL*0.98;
B4LA: RBEND, L := LBFL*1.16, ANGLE := ANGFFL*B4FL*1.37;

D4L: DRIFT, L:=LBFL*0.95;
D3L: DRIFT, L:=LBFL*0.72;

B3L:  RBEND, L:=LBFL*0.71, ANGLE:=ANGFFL*B3FL*0.71;
B1LB: RBEND, L:=LBFL*1.68, ANGLE:=ANGFFL*B1FL*1.68;
B1LA: RBEND, L:=LBFL*1.38, ANGLE:=ANGFFL*B0FL*1.38;
B0L:  RBEND, L:=LBFL*1.1, ANGLE:=ANGFFL*B0FL*1.1;
BSL:  RBEND, L:=LBFL*0.76, ANGLE:=ANGFFL*B0FL*0.76;

D7R: DRIFT, L:=LBFR*0.84+0.3;

B7R:  RBEND, L:=LBFR*0.84,  ANGLE:=ANGFFR*B7FR*0.84;
B6R:  RBEND, L:=LBFR*0.84,  ANGLE:=ANGFFR*B6FR*0.84;
B5RB: RBEND, L:=LBFR*0.84,  ANGLE:=ANGFFR*B5FR*0.94;
B5RA: RBEND, L:=LBFR*0.84,  ANGLE:=ANGFFR*B5FR*0.74;
B4RB: RBEND, L:=LBFR*0.76,  ANGLE:=ANGFFR*B4FR*0.66;
B4RA: RBEND, L:=LBFR*0.76,  ANGLE:=ANGFFR*B4FR*0.86;
B3R:  RBEND, L:=LBFR*0.665, ANGLE:=ANGFFR*B3FR*0.665;
B1RB: RBEND, L:=LBFR*0.749, ANGLE:=ANGFFR*B1FR*0.749;
B1RA: RBEND, L:=LBFR*0.547, ANGLE:=ANGFFR*B1FR*0.547;
B0R:  RBEND, L:=LBFR*0.358, ANGLE:=ANGFFR*B0FR*0.423;
BSR:  RBEND, L:=LBFR*0.358, ANGLE:=ANGFFR*B0FR*0.423;

! Technical Insertions Quadrupoles

MQL:     QUADRUPOLE, L = 1.0;
MQLHALF: QUADRUPOLE, L = 0.5;

QFL1A: MQL, K1:=KQFL1; QFL2A: MQL, K1:=KQFL2; QFL3A: MQL, K1:=KQFL3; QFL4A: MQL, K1:=KQFL4; QFL5A: MQL, K1:=KQFL5;
QDL1A: MQL, K1:=KQDL1; QDL2A: MQL, K1:=KQDL2; QDL3A: MQL, K1:=KQDL3; QDL4A: MQL, K1:=KQDL4; QDL5A: MQL, K1:=KQDL5;
QFL6A: MQL, K1:=KQFL6; QDL6A: MQLHALF, K1:=KQDL6;


! Experiment Insertion Quadrupoles

MQINSL: QUADRUPOLE, L=2.4;  ! Insertion Quadrupole; long
MQINSM: QUADRUPOLE, L=1.6;  ! Insertion Quadrupole; medium
MQINSS: QUADRUPOLE, L=0.8;  ! Insertion Quadrupole; short
MQINSMH: QUADRUPOLE, L=1.6/2; ! Insertion Quadrupole; medium split in half

QX2L:  MQINSMH, K1:=KQX02L; QX2R:  MQINSMH, K1:=KQX02R;
QX1L:  MQINSM,  K1:=KQX01L; QX1R:  MQINSM,  K1:=KQX01R;
QX0L:  MQINSS,  K1:=KQX00L; QX0R:  MQINSS,  K1:=KQX00R;

QY4L:  MQINSMH, K1:=KQY04L; QY4R:  MQINSMH, K1:=KQY04R;
QY3L:  MQINSS,  K1:=KQY03L; QY3R:  MQINSM,  K1:=KQY03R;
