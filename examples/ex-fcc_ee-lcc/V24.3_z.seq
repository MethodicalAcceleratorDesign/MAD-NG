		 DL_02B, QFM7R, DL_02C, QDM8R, DR_01, 2*SCRABR);

STRAIGHT_L: LINE=(DL_00, QDL1A, DL_04, QFL2A, DL_01, QDL2A, DL_01, QFL3A, DL_01M, RFC, DL_01M, QDL3A, DL_01, QFL6A,
                  DL_01, QDL4A, DL_06, DS1L, DL_05, QFL4A, DL_01, QDL5A, DL_01, QFL5A, DL_01, QDL5A, DL_01, QFL5A, DL_01, QDL6A, SCENTER);

