SDY1L: MSXIQ, K2:=KSDY1L;
SDM1L: MSXIH, K2:=KSDM1L;
SFM2L: MSXIH, K2:=KSFM2L;

! Insertion Thin multipoles

OCT0R: MULTIPOLE, KNL:={0,0,0,KOCT0R};
