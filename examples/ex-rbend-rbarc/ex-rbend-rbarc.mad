-- helper ---------------------------------------

local function dosrv (seq)
  io.write("survey: seq=", seq.name, " rbarc=", tostring(seq.rbarc), "\n")
  MAD.survey {sequence=seq} : print {"name", "kind", "s", "l", "angle"}
end

-- default ---------------------------------------

io.write("default: MADX.option.rbarc = ", tostring(MADX.option.rbarc), "\n")

-- local scope ----------------------------------

do
  io.write("\n*** local scope (no workspace) ***\n")
  local sequence, rbend in MAD.element
  local ss = sequence { l=5, refer="entry",
    rbend 'rb' {at=2, l=1, angle=0.5}
  }
  ss:dumpseq()
  dosrv(ss)
  ss.rbarc=true  -- activate rbarc for this sequence
  ss:update()    -- recompute things related to at, from and l(ength).
  ss:dumpseq()
  dosrv(ss)
  ss.rbarc=false -- show irreversibility
  ss:update()
  dosrv(ss)
end

-- workspace direct -----------------------------

do
  io.write("\n*** MADX-like workspace direct ***\n")
  local env = MADX {} -- new instance
  env:open_env()
  ss = sequence { l=5, refer="entry",
    rbend 'rb' {at=2, l=1, angle=0.5}
  }
  env:close_env()

  local ss in env
  dosrv(ss)
  ss.rbarc=true
  ss:update()
  dosrv(ss)
end

-- workspace using load -------------------------

do
  io.write("\n*** MADX-like workspace load ***\n")
  local env = MADX {} -- new instance
  env:load("ss.madx", {rbarc=true}) -- equiv. to set sequences with rbarc=true
  dosrv(env.ss)
end

-- workspace global -----------------------------

do
  io.write("\n*** MADX-like workspace direct ***\n")
  local env = MADX {} -- new instance
  env:open_env()
  option.rbarc = true -- affect all MADX instances (see next case)
  ss = sequence { l=5, refer="entry",
    rbend 'rb' {at=2, l=1, angle=0.5}
  }
  env:close_env()
  dosrv(env.ss)
end

-- workspace using load ----------------

do
  io.write("\n*** MADX-like workspace load + global ***\n")
  local env = MADX {} -- new instance
  env:load("ss.madx") -- persistent option.rbarc = true from previous case
  dosrv(env.ss)

  env:load("ss.madx", {rbarc=false}) -- reload to override option.rbarc
  dosrv(env.ss)
end

-------------------------------------------------
