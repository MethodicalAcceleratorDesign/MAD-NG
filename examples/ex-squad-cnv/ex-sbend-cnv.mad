local damap, beam, sequence, track in MAD
local sbend, quadrupole in MAD.element
local twopi in MAD.constant

local beam = beam {particle="proton"}
local cmap = false
local mthd = 8
local l  = 2
local a  = math.pi/4
local k0 = a/l

local bseq = sequence { beam=beam,
  sbend 'mb' {l=l, angle=a, k0=k0} --, k1=k1 }
}

local x0 = damap {nv=6,mo=2}

local bt, bf = track {sequence=bseq, X0=x0, method=mthd, cmap=cmap, debug=5}

bt:write"bt.tfs"
bf[1]:write("bf", "BF")
