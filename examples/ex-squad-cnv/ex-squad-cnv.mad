local damap, beam, sequence, track in MAD
local sbend, quadrupole in MAD.element
local fringe in MAD.element.flags
local twopi in MAD.constant

local beam = beam {particle="proton"}
local cmap = true
local frng = true
local sdir =  1
local edir = -1
local l  = 1.5
local a  = 0.005 -- 0
local k0 = a/l   -- 0.005
local k1 = 0.02

local bseq = sequence { beam=beam, dir=edir,
  sbend      'mb' {l=l, angle=a, k0=k0, k1=k1, kill_ent_fringe=not frng, kill_exi_fringe=not frng}
}
local qseq = sequence { beam=beam, dir=edir,
  quadrupole 'mq' {l=l, angle=a, k0=k0, k1=k1, kill_ent_fringe=not frng, kill_exi_fringe=not frng, fringe=fringe.bend, fastmap=true}
}

local x0 = damap {nv=6,mo=2}

local _, bf4 = track {sequence=bseq, X0=x0, method=4, dir=sdir, cmap=cmap} --, debug=5}
local _, bf6 = track {sequence=bseq, X0=x0, method=6, dir=sdir, cmap=cmap} --, debug=5}
local _, bf8 = track {sequence=bseq, X0=x0, method=8, dir=sdir, cmap=cmap} --, debug=5}
local _, qf4 = track {sequence=qseq, X0=x0, method=4, dir=sdir, cmap=cmap} --, debug=5}
local _, qf6 = track {sequence=qseq, X0=x0, method=6, dir=sdir, cmap=cmap} --, debug=5}
local _, qf8 = track {sequence=qseq, X0=x0, method=8, dir=sdir, cmap=cmap} --, debug=5}

bf4[1]:write("bf4", "BF4")
bf6[1]:write("bf6", "BF6")
bf8[1]:write("bf8", "BF8")
qf4[1]:write("qf4", "QF4")
qf6[1]:write("qf6", "QF6")
qf8[1]:write("qf8", "QF8")

local d,s = bf8[1]:dif(bf4[1],true) ; d:write("bf8_bf4", "BF8-BF4") ; s:print("BF8-BF4:")
local d,s = bf8[1]:dif(bf6[1],true) ; d:write("bf8_bf6", "BF8-BF6") ; s:print("BF8-BF6:")
local d,s = qf8[1]:dif(qf4[1],true) ; d:write("qf8_qf4", "QF8-QF4") ; s:print("QF8-QF4:")
local d,s = qf8[1]:dif(qf6[1],true) ; d:write("qf8_qf6", "QF8-QF6") ; s:print("QF8-QF6:")
local d,s = qf4[1]:dif(bf4[1],true) ; d:write("qf4_bf4", "QF4-BF4") ; s:print("QF4-BF4:")
local d,s = qf6[1]:dif(bf6[1],true) ; d:write("qf6_bf6", "QF6-BF6") ; s:print("QF6-BF6:")
local d,s = qf8[1]:dif(bf8[1],true) ; d:write("qf8_bf8", "QF8-BF8") ; s:print("QF8-BF8:")
