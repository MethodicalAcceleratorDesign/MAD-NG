local damap, beam, sequence, track in MAD
local sbend in MAD.element
local twopi in MAD.constant

local beam = beam {particle="proton"}
local cmap = true
local mthd = 4 -- 4,6,8
local l  = 1
local a  = math.pi/5 -- fails with math.pi/4
local k0 = a/l

local bseq = sequence { beam=beam,
  sbend 'mb' {l=l, angle=a, k0=k0}
}

local x0 = damap {nv=6,mo=2}

local _, bf = track {sequence=bseq, X0=x0, method=mthd, model="DKD", cmap=cmap} --, debug=5}

bf[1]:write("bf"..mthd, "BF"..mthd)
