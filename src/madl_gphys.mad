-- locals ---------------------------------------------------------------------o

local assert, table, type in _G

local min, max in math

local vector, cvector, matrix, monomial, damap, cdamap,
      trace, warn, option, typeid, range                         in MAD
local assertf, errorf, printf, num2str, tbl2str, setkeys, tblcat,
      mockfile, openfile                                         in MAD.utility
local lbool                                                      in MAD.gfunc
local pi, twopi, rad2deg                                         in MAD.constant
local abs, sqrt, exp, log, sin, cos, tan, atan2, tgamma, lgamma,
      sinh, cosh, real, imag, cplx, fact, rangle, hypot, sign, conj in MAD.gmath
    
local is_nil, is_boolean, is_number, is_positive, is_nonzero, is_integer,
      is_natural, is_nznatural, is_even, is_odd, is_string, is_table,
      is_mappable, is_indexable, is_monomial,
      is_matrix, is_cmatrix, isa_matrix, is_vector, is_cvector,
      is_tpsa, is_damap, is_cdamap, isa_damap, wrestrict         in MAD.typeid

local r4  = range(1,4)
local r6  = range(1,6)
local I4  = matrix(4):eye()
local I6  = matrix(6):eye()
local I56 = matrix(6):set(5,5,1):set(6,6,1)
local S4  = matrix(4):symp() -- [4x4] symplectic matrix S
local S6  = matrix(6):symp() -- [6x6] symplectic matrix S

                -- i,j,k,l, i,j,k,l, i,j,k,l, i,j,k,l,
local blkidx   = { 3,1,1,3, 3,3,1,1 } --, 5,1,1,5, 5,3,3,5 } -- keep order!
local blkidx_n = #blkidx

-- implementation -------------------------------------------------------------o

local gphys = {
  -- tolerances
  tol = {
    dpt_tol  = 1e-12,
    pha_tol  = 1e-12,
    eig_tol  = 1e-12,
    nrm_tol  = 1e-12,
    damp_tol = 1e-8,
    symp_tol = 1e-12,
    cplg_tol = 1e-14,
    ofun_tol = 1e-14,
    stab_tol = 1e-16, -- below eps!
  },

  -- optical functions names (index -> name)
  ofname = {
    'alfa11', 'beta11', 'gama11', 'mu1', 'dx', 'dpx',
    'alfa22', 'beta22', 'gama22', 'mu2', 'dy', 'dpy',
    'alfa33', 'beta33', 'gama33', 'mu3',
  },

  -- optical functions names with coupling (index -> name)
  ofcname = {
    'alfa11', 'beta11', 'gama11', 'alfa12', 'beta12', 'gama12', 'alfa13', 'beta13', 'gama13', 'mu1', 'dx', 'dpx',
    'alfa21', 'beta21', 'gama21', 'alfa22', 'beta22', 'gama22', 'alfa23', 'beta23', 'gama23', 'mu2', 'dy', 'dpy',
    'alfa31', 'beta31', 'gama31', 'alfa32', 'beta32', 'gama32', 'alfa33', 'beta33', 'gama33', 'mu3',
    'betx'  , 'bety'  , 'alfx'  , 'alfy'  , 'kpa'   , 'r11'   , 'r12'   , 'r21'   , 'r22'   , -- Edwards-Teng
    'f1010' , 'f1001', -- linear RDTs
  },

  -- optical functions names with chromatic functions (index -> name)
  ofhname = {
    'alfa11', 'beta11', 'gama11', 'mu1', 'dmu1', 'dx', 'dpx', 'Dx', 'Dpx', 'ddx', 'ddpx', 'wx', 'phix',
    'alfa22', 'beta22', 'gama22', 'mu2', 'dmu2', 'dy', 'dpy', 'Dy', 'Dpy', 'ddy', 'ddpy', 'wy', 'phiy',
    'alfa33', 'beta33', 'gama33', 'mu3', 'dmu3',
  },

  -- optical functions names with coupling and chromatic functions (index -> name)
  ofchname = {
    'alfa11', 'beta11', 'gama11', 'alfa12', 'beta12', 'gama12', 'alfa13', 'beta13', 'gama13', 'mu1', 'dmu1', 'dx', 'dpx', 'Dx', 'Dpx', 'ddx', 'ddpx', 'wx', 'phix',
    'alfa21', 'beta21', 'gama21', 'alfa22', 'beta22', 'gama22', 'alfa23', 'beta23', 'gama23', 'mu2', 'dmu2', 'dy', 'dpy', 'Dy', 'Dpy', 'ddy', 'ddpy', 'wy', 'phiy',
    'alfa31', 'beta31', 'gama31', 'alfa32', 'beta32', 'gama32', 'alfa33', 'beta33', 'gama33', 'mu3', 'dmu3',
    'betx'  , 'bety'  , 'alfx'  , 'alfy'  , 'kpa'   , 'r11'   , 'r12'   , 'r21'   , 'r22'   , -- Edwards-Teng
    'f1010' , 'f1001' , -- linear RDTs
  },
}

local phystol = gphys.tol

-- particles ------------------------------------------------------------------o

local val = \a -> is_number(a) and a or nil

function gphys.par2vec (X, V_)
  local V = V_ or vector(6)
  if is_number(X) then return V:fill(X) end
  V[1], V[2] = val(X.x) or X[1] or 0, val(X.px) or X[2] or 0
  V[3], V[4] = val(X.y) or X[3] or 0, val(X.py) or X[4] or 0
  V[5], V[6] = val(X.t) or X[5] or 0, val(X.pt) or X[6] or 0
  return V
end

function gphys.vec2par (V, X_)
  local X = X_ or table.new(0,8)
  X.x, X.px = V[1], V[2]
  X.y, X.py = V[3], V[4]
  X.t, X.pt = V[5], V[6]
  return X
end

-- mtables --------------------------------------------------------------------o

 -- TODO: move to mtable or track or (new) lost

function gphys.mchklost (mtbl, ...)
  assert(typeid.is_mtable(mtbl), "invalid argument #1 (mtable expected)")
  return mtbl.lost == 0 and mtbl or nil, ...
end

local kil = { ksl  =-1,
              k0l  = 1, k1l  = 2, k2l  = 3, k3l = 4, k4l = 5, k5l = 6, k6l = 7,
              k0sl = 1, k1sl = 2, k2sl = 3, k3sl= 4, k4sl= 5, k5sl= 6, k6sl= 7 }

 -- TODO: move to mtable or sequence

function gphys.melmcol (mtbl, cols)
  assert(typeid.is_mtable(mtbl), "invalid argument #1 (mtable expected)")
  assert(is_mappable(cols)     , "invalid argument #2 (mappable expected)")
  assert(typeid.is_sequence(mtbl.__seq), "no attached sequence found")
  assert(not is_nil (mtbl.eidx ), "no elements index column 'eidx' found")
  assert(is_table(mtbl.eidx ) or is_vector(mtbl.eidx),
                "invalid index column 'eidx', (table or vector expected)")

  for k, v in pairs(cols) do
    if is_integer(k) then k = v end
    if not kil[v] then -- standard attribute
      mtbl:addcol(k, \ir =>
        local idx = mtbl.eidx[ir]
        return is_integer(idx) and mtbl.__seq[idx][v] or 0 end)

    elseif kil[v] > 0 then -- add local and integrated strengths
      local knol, kidx = string.sub(v,1,-2), kil[v]
      local knsl = string.sub(knol, -1) ~= 's' and 'knl' or 'ksl'
      mtbl:addcol(k, \ir =>
        local idx = mtbl.eidx[ir]
        if not is_integer(idx) then return 0 end -- implicit drift
        local elm = mtbl.__seq[idx]
        return (elm[knol] or 0) * elm.l + ((elm[knsl] or {})[kidx] or 0) end)
    elseif kil[v] < 0 then -- add special strengths (e.g. solenoid)
      mtbl:addcol(k, \ir =>
        local idx = mtbl.eidx[ir]
        if not is_integer(idx) then return 0 end -- implicit drift
        local elm = mtbl.__seq[idx]
        return (elm.ks or 0) * elm.l + (elm.ksi or 0) end)
    else errorf("unkown element to column generator for '%s'", tostring(v))
    end
  end

  return mtbl
end

-- mflows ---------------------------------------------------------------------o

-- particles/damaps status rank: Xset/Mset/Aset/stable/unstable/singular/lost
local mrnk = {Xset=1, Mset=1, Aset=1, stable=1, unstable=2, singular=3, lost=4}
gphys.mrnk = mrnk

-- compare particles/damaps by rank then id
function gphys.mcmp (ma, mb)
  local ra, rb = mrnk[ma.status], mrnk[ma.status]
  assert(ra and rb, "unknown status detected")
  return ra == rb and ma.id < mb.id or ra < rb
end

-- sort particles/damaps, adjust npar
function gphys.msort (mflw, cmp_)
  assert(typeid.is_dynmflw(mflw),"invalid argument #1 (dynamic mflow expected)")

  mflw.npar = #mflw
  if mflw.npar > 1 then table.sort(mflw, cmp_ or gphys.mcmp) end

  -- adjust npar to the number of trackable particles
  for i=mflw.npar,1,-1 do
    if mrnk[mflw[i].status] <= mrnk.stable then mflw.npar=i break end
  end

  return mflw:cmap_sync()
end

-- checkers -------------------------------------------------------------------o

local function chksysiz (V, W)
  if not is_nil(V) then
    assert(is_matrix(V), "invalid argument #1 (matrix expected)")
    assert((V.nrow == 6 or V.nrow == 4) and V.nrow == V.ncol,
           "invalid sizes (4D/6D matrix expected)")
    if not is_nil(W) then
      assert(is_cvector(W), "invalid argument #2 (cvector expected)")
      assert(W.nrow == V.nrow, "invalid size (4D/6D cvector expected)")
    end
  end

  return V, W
end

-- check if system is eigen using eigtol tolerance
-- check M*Vi = Wi*Vi

local eig_tol in phystol

local function is_eigsys (M, V, W, eigtol_)
  local tol = eigtol_ or eig_tol
  assert(is_positive(tol), "invalid argument #4 (positive number expected)")

  if option.debug >= 2 then
    io.write("**Eigensystem:\n")
    M:print('Input vectors ')
    W:print('Eigenvalues ')
    V:print('Eigenvectors ')
  end

  for i=2,#W,2 do
    local dW = W[i-1]-W[i]:conj()
    if not dW:eq(0, tol) then
      warn("invalid eigenvalues #%d (conjugate pair deviates by %s)",
           i-1, num2str(dW:abs()))
      return false
    end

    local Vi = cplx(V:getcol(i-1), V:getcol(i))
    local Vc = Vi:conj()
    local dV1, dV2 = M*Vi-W[i-1]*Vi, M*Vc-W[i]*Vc
    if not (dV1:eq(0, tol) and dV2:eq(0, tol)) then
      warn("invalid eigensystem #%d (M*V deviates from W*V by %s)",
           i-1, num2str(max(dV1:norm(),dV2:norm())))
      return false
    end
  end

  return true
end

gphys.is_eigsys = \V,W,M,tol -> is_eigsys(chksysiz(M,W), chksysiz(V,W), W, tol)

-- check for delta pt in one-turn map using dptol tolerance

local dpt_tol in phystol

local function has_dpt (m, dptol_)
  local tol = dptol_ or dpt_tol
  assert(is_positive(tol), "invalid argument #2 (positive number expected)")

  if is_damap(m) then
    if #m < 6 then return false end
    local i, pt = 2, m.pt
    if abs(pt:get(7) - 1) <= tol then
      while i < 7 and abs(pt:get(i)) <= tol do i = i+1 end
    end
    return i ~= 7
  elseif is_matrix(m) then
    if min(m:sizes()) < 6 then return false end
    local i = 1
    if abs(m:get(6,6) - 1) <= tol then
      while i < 6 and abs(m:get(6,i)) <= tol do i = i+1 end
    end
    return i ~= 6
  else error("invalid argument #1 (matrix or damap expected)") end
end

gphys.has_dpt = has_dpt

-- check for coupling blocks in one-turn map using cplg_tol

local cplg_tol in phystol

local function has_cpl (M, cpltol_)
  local tol = cpltol_ or cplg_tol
  assert(is_positive(tol), "invalid argument #2 (positive number expected)")

  -- check only transverse coupling
  if blkidx[1] > M.nrow then return false end
  local i,j,k,l = blkidx[1], blkidx[2], blkidx[3], blkidx[4]
  local v = max(abs(M:get(i  ,j)), abs(M:get(i  ,j+1)),
                abs(M:get(i+1,j)), abs(M:get(i+1,j+1)),
                abs(M:get(k  ,l)), abs(M:get(k  ,l+1)),
                abs(M:get(k+1,l)), abs(M:get(k+1,l+1)))
  return v >= tol
end

gphys.has_cpl = \M,tol -> has_cpl(chksysiz(M), tol)

-- helpers --------------------------------------------------------------------o

-- conversion between energy deviation and momentum or beta
-- dp = (P-P0)/P0, pt = (E-E0)/P0c
-- (1+dp)^2 = 1 + 2pt/beta + pt^2

local function dp2pt (dp, beta0)
  local _beta0 = 1/beta0
  return dp ~= 0 and sqrt((1+dp)^2 + (_beta0^2-1)) - _beta0 or 0
end

gphys.dp2pt = dp2pt

local function pt2dp (pt, beta0)
  return pt ~= 0 and sqrt(1 + 2*pt/beta0 + pt^2) - 1 or 0
end

gphys.pt2dp = pt2dp

local function pt2beta (pt, beta0)
  if pt == 0 then return beta0 end
  return (1 + (2/beta0)*pt + pt^2) / (1/beta0 + pt)
end

gphys.pt2beta = pt2beta

-- eigensystem ----------------------------------------------------------------o

-- retrieve eigenvalues from pairs of eigenvectors

local function get_eigval (M, V, W)
  -- get eigenvalues Wi from eigenvectors Vi: M*Vi = Wi*Vi
  for i=2,V.nrow,2 do
    local v = cplx(V:getcol(i-1), V:getcol(i))
    W[i-1] = M:get(i-1,i-1) + M:get(i-1,i)*v:get(i,i-1)/v:get(i-1,i-1)
    W[i  ] = W[i-1]:conj()
  end
  return W
end

gphys.get_eigval = \M,V,W -> get_eigval(chksysiz(M), chksysiz(V,W))

-- stability ------------------------------------------------------------------o

-- check stability, enforce orthogonality of planes if needed

local stab_tol in phystol

local function make_stable (M)
  -- check trace stability
  for i=2,M.nrow,2 do
    local tr = abs(M:get(i-1,i-1)+M:get(i,i))
    if tr > 2 then warn("Tr(M)>2 for plane %d, unstable motion!", i/2) end
  end

  if option.dontstab then return end

  -- stabilize the one-turn-map M to avoid unstable eigenvectors in case of
  -- perfectly equal transverse tunes and no coupling. stab_tol is lower than
  -- eps, hence it will remove only numerical noise as the one-turn-map is
  -- supposed to be around the identity where eps represents both a relative
  -- and an absolute numerical error.
  for idx=1,blkidx_n,4 do
    if blkidx[idx] > M.nrow then break end
    local i,j,k,l = blkidx[idx], blkidx[idx+1], blkidx[idx+2], blkidx[idx+3]
    local mx = max(abs(M:get(i  ,j)), abs(M:get(i  ,j+1)),
                   abs(M:get(i+1,j)), abs(M:get(i+1,j+1)),
                   abs(M:get(k  ,l)), abs(M:get(k  ,l+1)),
                   abs(M:get(k+1,l)), abs(M:get(k+1,l+1)))
    if mx < stab_tol then
      M:set(i  ,j,0) ; M:set(i  ,j+1,0)
      M:set(i+1,j,0) ; M:set(i+1,j+1,0)
      M:set(k  ,l,0) ; M:set(k  ,l+1,0)
      M:set(k+1,l,0) ; M:set(k+1,l+1,0)
      break
    end
  end
end

gphys.make_stable = \M -> make_stable(chksysiz(M))

-- symplectification ----------------------------------------------------------o

-- symplectifiy one-turn map M if needed
-- Algorithm described in the doctoral thesis of Liam Healey.

local symp_tol, damp_tol in phystol

local function make_symp (M)
  local serr = M:symperr()
  if serr <= symp_tol then return end

  trace(0, "symplectic deviation: %s", num2str(serr))

  if serr >= damp_tol or option.dontsymp then return end

  local n, rnk, err = max(M:sizes())
  local I, A, V = M:same():eye()

  V, rnk = (I-M):div(I+M)
  if rnk == n then
    A = (V:bar()-V)/2
    V, rnk = (I+A):div(I-A)
    if rnk == n then V:copy(M) end
  end

  if rnk < n
  then warn("symplectification failed (singular matrix, left unchanged).")
  else trace(0, "symplectified deviation: %s", num2str(M:symperr()))
  end
end

gphys.make_symp = \M -> make_symp(chksysiz(M))

-- closed form, eigen systems -------------------------------------------------o

  -- order in place eigenvectors/values by planes (x,px), (y,py) and (t,pt).

local function order_eigen (V, W)
  local n = min(6,V:sizes())
  local f = {false,false}
  local p

  if option.eigen123
  then p = n > 4 and {1,3,5} or {1,3}  -- search by 1st, 2nd, 3rd order.
  else p = n > 4 and {3,1,5} or {3,1}  -- search by 2nd, 1st, 3rd order.
  end

  for _,i in ipairs(p) do -- scan planes
    local mv, k = 0, i
    for j=1,n-1,2 do
      local pv = V:get(i,j  )^2 + V:get(i+1,j  )^2 + -- real part
                 V:get(i,j+1)^2 + V:get(i+1,j+1)^2   -- imag part
      if pv > mv then mv, k = pv, j end
    end
    assert(mv > 0, "invalid sub-rank eigenvectors (zero-row pair found)")
    if not f[(k+1)/2] then f[(i+1)/2] = (k+1)/2 end
  end

  for ii,kk in ipairs(f) do
    if ii ~= kk then
      local i, k = ii*2-1, kk*2-1
      V:swpcol({i,i+1}, {k,k+1})   -- swap eigenvectors/eigenvalues pairs
      if not is_nil(W) then
        W[i], W[i+1], W[k], W[k+1] = W[k], W[k+1], W[i], W[i+1]
      end
    end
  end

  if option.debug >= 2 then
    io.write("**Ordered eigensystem:\n")
    for i,k in ipairs(f) do
      io.write("order_eigen: rk=",n,", ",i," <-> ",k,"\n")
    end
    V:print('Eigenvectors ')
    if not is_nil(W) then W:print('Eigenvalues ') end
  end
end

gphys.order_eigen = \V,W_ -> order_eigen(chksysiz(V,W_))

-- normalize in place eigenvectors such that [x,px]=1, [y,py]=1 and [t,pt]=1

local function norml_eigen (A)
  for j=2,A.ncol,2 do
    local pb = 0           -- poisson bracket (columns pair)
    for i=2,A.nrow,2 do
      pb = pb + A:get(i-1,j-1) * A:get(i,j) - A:get(i-1,j) * A:get(i,j-1)
    end
    local spb = sqrt(abs(pb))
    assertf(spb > 0, "invalid eigenvectors pair %d (unexpected [v,w]=0)", j)
    for i=1,A.nrow do      -- normalize plane (columns)
      A:set(i,j-1, A:get(i,j-1) * (spb / pb))
      A:set(i,j  , A:get(i,j  ) /  spb      )
    end
  end

  if option.debug >= 2 then
    io.write("**Normalized eigensystem:\n")
    A:print('Eigenvectors ') ; io.write("symperr=", num2str(A:symperr()), "\n")
  end
end

gphys.norml_eigen = \A -> norml_eigen(chksysiz(A))

-- rephase in place the eigenvectors to obtain the Courant-Snyder form
-- i.e. A(1,2)=0 and mu1>0, A(3,4)=0 and mu2>0, A(5,6)=0 and mu3>0

local function phase_eigen (A)
  local nr, nc = A:sizes()
  local P = matrix(nc,nr):eye()

  for i=2,min(nr,nc),2 do
    local a11, a12 = A:get(i-1,i-1), A:get(i-1,i) -- mu = atan2(a12, a11) / 2pi
    local d = hypot(a11,a12)
!   if a11 < 0 then d = -d end  -- add pi (sometimes needed for comparison with PTC...)
    assertf(d > 1e-14, "invalid eigenvectors (unexpected denom |% -.16e|>0)", d)
    a11, a12 = a11/d, a12/d
    P:set(i-1,i-1,  a11) -- P = [ a11/d  -a12/d ] = [ cos a  -sin a ]
    P:set(i-1,i  , -a12) --     [ a12/d   a11/d ]   [ sin a   cos a ] = rot(a)
    P:set(i  ,i-1,  a12) -- a = angle(a11, a12)
    P:set(i  ,i  ,  a11)
  end

-- A*P=[ a11  a12 ][ a11/d  -a12/d ]=[      d (>0)                0          ]
--     [ a21  a22 ][ a12/d   a11/d ] [ (a11a21+a12a22)/d  (-a12a21+a11a22)/d ]

  A:mul(P,A) -- A = A*P (rotate planes of A => a12=a34=0)

  if option.debug >= 2 then
    io.write("**Rephased eigenvectors:\n")
    A:print('Eigenvectors ') ; io.write("symperr=", num2str(A:symperr()), "\n")
  end

  return A
end

gphys.phase_eigen = \A -> phase_eigen(chksysiz(A))

-- linear and non-linear normal form ------------------------------------------o

local nf_id = {}
local is_nf = \a -> is_table(a) and a.__id == nf_id

MAD.typeid.is_nform = is_nf

-- getters --

local function nf_pms (nf, ki_, ko_)
  assert(is_nf(nf) or is_damap(nf),
         "invalid argument #1 (damap or normal form expected)")
  local np, ki, ks = is_nf(nf) and nf.nn-nf.nv or nf:np(), ki_ or 0

  if is_natural(ki) then      -- index case
    local ko = ko_ or 1
    assert(is_natural(ko), "invalid knob order (ko >= 0 expected)")
    ks = ki > 0 and ko > 0 and ("0"):rep(ki-1)..ko..("0"):rep(np-(ki-1)-1)
                            or ("0"):rep(np)
  else
    if is_monomial(ki) then -- monomial case
      ks = ki:tostring()
    elseif is_string(ki) then   -- string case
      ks = ki
    else error("invalid argument #2 (monomial, string or index expected)")
    end
    if #ks < np then ks = ks..("0"):rep(np-#ks) end
  end

  return ks
end

local function nf_ms (nf, ms, ki_, ko_)
  assert(is_nf(nf), "invalid argument #1 (normal form expected)")

  if is_table(ms) then -- expand table
    ms, ki_, ko_ = ms[1], ms[2], ms[3]
  end

  if is_monomial(ms) then -- monomial case
    ms = ms:tostring()
  else                    -- string case
    assert(is_string(ms), "invalid argument #2 (monomial or string expected)")
  end

  if ki_
  then if #ms < nf.nv then ms = ms..("0"):rep(nf.nv - #ms) end
           ms = ms..nf_pms(nf, ki_, ko_)
  else if #ms < nf.nn then ms = ms..("0"):rep(nf.nn - #ms) end
  end

  return ms
end

local function nf_q (nf, ord, x, y, t)
  local ms = table.concat{x, 0, y, 0, t, 0}
  local ks = nf_pms(nf, ord[2])
  local rv = nf.anh[ms..ks] or 0
--print("nf_q"..(x==1 and '1' or y==1 and '2' or t==1 and '3' or '0'), ms..ks, rv, nf.anh[ms..ks] and '' or nil)
  return rv
end

local function nf_dq (nf, ord, x, y, t)
  local ms = table.concat{x, 0, y, 0, t, ord[1]}
  local ks = nf_pms(nf, ord[2])
  local rv = nf.anh[ms..ks] or 0
--print("nf_dq"..(x==1 and '1' or y==1 and '2' or t==1 and '3' or '0'), ms..ks, rv, nf.anh[ms..ks] and '' or nil)
  return rv
end

local function nf_anh (nf, ord, x, y, t)
  local mn = {ord[1]+x, ord[1], ord[2]+y, ord[2], nf.ipt==0 and ord[3]+t or 0, ord[3] or 0}
  local ms = table.concat(mn)
  local ks = nf_pms(nf, ord[4])
  local rv = nf.anh[ms..ks] or 0
--print("nf_anh"..(x==1 and 'x' or y==1 and 'y' or t==1 and 't' or '?'), ms..ks, rv, nf.anh[ms..ks] and '' or nil)
  return rv
end

-- tunes --

local function nf_q1 (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 1} end
  assert(is_indexable(ord)   , "invalid argument #2 (indexable expected)")
  assert(is_nznatural(ord[1]), "invalid q1 order (q1 > 0 expected)")
  if ord[1] == 1 and (ord[2] or 0) == 0 then return nf.q1_ end
  return nf_q(nf, ord, ord[1], 0, 0)
end

local function nf_q2 (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 1} end
  assert(is_indexable(ord)   , "invalid argument #2 (indexable expected)")
  assert(is_nznatural(ord[1]), "invalid q2 order (q2 > 0 expected)")
  if ord[1] == 1 and (ord[2] or 0) == 0 then return nf.q2_ end
  return nf_q(nf, ord, 0, ord[1], 0)
end

local function nf_q3 (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 1} end
  assert(is_indexable(ord)   , "invalid argument #2 (indexable expected)")
  assert(is_nznatural(ord[1]), "invalid q3 order (q3 > 0 expected)")
  if ord[1] == 1 and (ord[2] or 0) == 0 then return nf.q3_ end
  return nf_q(nf, ord, 0, 0, ord[1])
end

-- chromaticities --

local function nf_dq1 (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 1} end
  assert(is_indexable(ord)   , "invalid argument #2 (indexable expected)")
  assert(is_nznatural(ord[1]), "invalid pt order (pt > 0 expected)")
  return nf_dq(nf, ord, 1, 0, 0)
end

local function nf_dq2 (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 1} end
  assert(is_indexable(ord)   , "invalid argument #2 (indexable expected)")
  assert(is_nznatural(ord[1]), "invalid pt order (pt > 0 expected)")
  return nf_dq(nf, ord, 0, 1, 0)
end

local function nf_dq3 (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 1} end
  assert(is_indexable(ord)   , "invalid argument #2 (indexable expected)")
  assert(is_nznatural(ord[1]), "invalid pt order (pt > 0 expected)")
  return nf_dq(nf, ord, 0, 0, 1)
end

-- anharmonicities --

local function nf_anhx (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {ord or 0,0,0} end
  assert(is_indexable(ord), "invalid argument #2 (order or indexable expected)")
  assert(is_natural(ord[1]),"invalid x order (x >= 0 expected)")
  return nf_anh(nf, ord, 1, 0, 0)
end

local function nf_anhy (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {0,ord or 0,0} end
  assert(is_indexable(ord), "invalid argument #2 (order or indexable expected)")
  assert(is_natural(ord[2]),"invalid y order (y >= 0 expected)")
  return nf_anh(nf, ord, 0, 1, 0)
end

local function nf_anht (nf, ord)
  if is_nil(ord) or is_number(ord) then ord = {0,0,ord or 0} end
  assert(is_indexable(ord), "invalid argument #2 (order or indexable expected)")
  assert(is_natural(ord[3]),"invalid t order (t >= 0 expected)")
  return nf_anh(nf, ord, 0, 0, 1)
end

-- generating functions --

local function nf_gnfu (nf, ms, ki_, ko_)
  local ms = nf_ms(nf, ms, ki_, ko_)
  return nf.gnf[ms] or 0i
end

-- hamiltonian terms --

local function nf_haml (nf, ms, ki_, ko_)
  local ms = nf_ms(nf, ms, ki_, ko_)
  return nf.ham[ms] or 0i
end

-- optical functions --

local s2p = { 1, 2, 3, ["1"]=1, ["2"]=2, ["3"]=3, x=1, y=2, z=3, t=3 }
local s2v = { 1, 2, 3, 4, ["1"]=1, ["2"]=2, ["3"]=3, ["4"]=4, x=1, px=2, y=3, py=4 }

local function nf_bet (a, p, mon, mt)
  assert(a:maxord() >= 1+mon:ord(),
    "beta: damap order is too low %d < %d", a:maxord(), 1+mon:ord())
  local p1 = assertf(s2p[p:sub(1,1)], "invalid plane '%s'", p)
  local p2 = assertf(s2p[p:sub(2,2)] or p1, "invalid plane '%s'", p)
  local v1, v2 = 2*(p1-1)+1, 2*(p2-1)+1
  local bet = mt["bet"..p] --; io.write("bet"..p, "\n")
  if not bet then
    local a11 = mt[v1..v2  ] or a[v1]:deriv(v2+0) ; mt[v1..v2  ] = a11
    local a12 = mt[v1..v2+1] or a[v1]:deriv(v2+1) ; mt[v1..v2+1] = a12
          bet = a11^2 + a12^2                     ; mt["bet"..p] = bet
  end
  return bet:get(mon) * mon:ordpf()
end

local function nf_alf (a, p, mon, mt)
  assert(a:maxord() >= 1+mon:ord(),
    "alfa: damap order is too low %d < %d", a:maxord(), 1+mon:ord())
  local p1 = assertf(s2p[p:sub(1,1)], "invalid plane '%s'", p)
  local p2 = assertf(s2p[p:sub(2,2)] or p1, "invalid plane '%s'", p)
  local v1, v2 = 2*(p1-1)+1, 2*(p2-1)+1
  local alf = mt["alf"..p] --; io.write("alf"..p, "\n")
  if not alf then
    local a11 = mt[v1  ..v2  ] or a[v1  ]:deriv(v2+0) ; mt[v1  ..v2  ] = a11
    local a12 = mt[v1  ..v2+1] or a[v1  ]:deriv(v2+1) ; mt[v1  ..v2+1] = a12
    local a21 = mt[v1+1..v2  ] or a[v1+1]:deriv(v2+0) ; mt[v1+1..v2  ] = a21
    local a22 = mt[v1+1..v2+1] or a[v1+1]:deriv(v2+1) ; mt[v1+1..v2+1] = a22
          alf = -(a11*a21+a12*a22)                    ; mt["alf"..p  ] = alf
  end
  return alf:get(mon) * mon:ordpf()
end

local function nf_gam (a, p, mon, mt)
  assertf(a:maxord() >= 1+mon:ord(),
    "gama: damap order is too low %d < %d", a:maxord(), 1+mon:ord())
  local p1 = assertf(s2p[p:sub(1,1)], "invalid plane '%s'", p)
  local p2 = assertf(s2p[p:sub(2,2)] or p1, "invalid plane '%s'", p)
  local v1, v2 = 2*(p1-1)+1, 2*(p2-1)+1
  local gam = mt["gam"..p] --; io.write("gam"..p, "\n")
  if not gam then
    local a21 = mt[v1+1..v2  ] or a[v1+1]:deriv(v2+0) ; mt[v1+1..v2  ] = a21
    local a22 = mt[v1+1..v2+1] or a[v1+1]:deriv(v2+1) ; mt[v1+1..v2+1] = a22
          gam = a21^2+a22^2                           ; mt["gam"..p  ] = gam
  end
  return gam:get(mon) * mon:ordpf()
end

local function nf_pha (a, p, mt)
  local p = assertf(s2p[p], "invalid plane '%s'", p)
  local v = 2*(p-1)+1
  local pha = mt["pha"..p] --; io.write("pha"..p, "\n")
  if not pha then
    local a11 = mt[v..v  ] or a[v]:deriv(v+0) ; mt[v..v    ] = a11
    local a12 = mt[v..v+1] or a[v]:deriv(v+1) ; mt[v..v+1  ] = a12
    pha = atan2(a12, a11)/twopi               ; mt["pha"..p] = pha
  end
  return pha
end

local function nf_mu (a, p, mon, mt, a0_, mt0_)
  assertf(a:maxord() >= 1+mon:ord(),
    "mu: damap order is too low %d < %d", a:maxord(), 1+mon:ord())
  local pha = nf_pha(a, p, mt)
  if a0_ then pha = pha - nf_pha(a0_, p, mt0_) end
  return pha:get(mon) * mon:ordpf()
end

local function nf_dmu (a, p, mon, mt, a0_, mt0_)
  assertf(a:maxord() >= 2+mon:ord(),
    "dmu: damap order is too low %d < %d", a:maxord() , 2+mon:ord())
  mon[6] = mon[6]+1
  return nf_mu(a, p, mon, mt, a0_, mt0_)
end

local function nf_dsp (a, v, mon)
  assertf(a:maxord() >= 1+mon:ord(),
    "disp: damap order is too low %d < %d", a:maxord() , 1+mon:ord())
  local v = assertf(s2v[v], "invalid variable '%s'", v)
  mon[6] = mon[6]+1
  return a[v]:get(mon) * mon:ordpf()
end

local function nf_wf (a, p, mt)
  local p = assertf(s2p[p], "invalid plane '%s'", p)
  local v = 2*(p-1)+1
  local bet, alf = mt["bet"..p..p], mt["alf"..p..p] --; io.write("bet"..p..p, ", ", "alf"..p..p, "\n")
  if not (bet and alf) then
    local a11 = mt[v  ..v  ] or a[v  ]:deriv(v+0) ; mt[v  ..v     ] = a11
    local a12 = mt[v  ..v+1] or a[v  ]:deriv(v+1) ; mt[v  ..v+1   ] = a12
    local a21 = mt[v+1..v  ] or a[v+1]:deriv(v+0) ; mt[v+1..v     ] = a21
    local a22 = mt[v+1..v+1] or a[v+1]:deriv(v+1) ; mt[v+1..v+1   ] = a22
          bet =   a11^2 + a12^2                   ; mt["bet"..p..p] = bet
          alf = -(a11*a21+a12*a22)                ; mt["alf"..p..p] = alf
  end
  local bx, ax = mt["bx"..p], mt["ax"..p]
  if not (bx and ax) then
    bx = bet:deriv(6) / bet    ; mt["bx"..p] = bx
    ax = alf:deriv(6) - alf*bx ; mt["ax"..p] = ax
  end
  return bx, ax
end

local function nf_wrf (a, p, mon, mt)
  assertf(a:maxord() >= 2+mon:ord(),
    "wf: damap order is too low %d < %d", a:maxord(), 2+mon:ord())
  local wrf = mt["wrf"..p] --; io.write("wrf"..p, "\n")
  if not wrf then
    local bx, ax = nf_wf(a, p, mt)
    wrf = sqrt(bx^2 + ax^2) ; mt["wrf"..p] = wrf
  end
  return wrf:get(mon) * mon:ordpf()
end

local function nf_wpf (a, p, mon, mt)
  assertf(a:maxord() >= 2+mon:ord(),
    "wfp: damap order is too low %d < %d", a:maxord(), 2+mon:ord())
  local wpf = mt["wpf"..p] --; io.write("wpf"..p, "\n")
  if not wpf then
    local bx, ax = nf_wf(a, p, mt)
    wpf = atan2(ax, bx) ; mt["wpf"..p] = wpf
  end
  return wpf:get(mon) * mon:ordpf()/twopi
end

local optfct = { alfa=nf_alf, beta=nf_bet, gama=nf_gam, disp=nf_dsp, mu=nf_mu, dmu=nf_dmu,
                 dx=nf_dsp, dy=nf_dsp, dpx=nf_dsp, dpy=nf_dsp,
                 wx=nf_wrf, wy=nf_wrf, wxp=nf_wpf, wyp=nf_wpf, }
local optlst = { alfa="alfa", beta="beta", gama="gama", disp="disp", mu="mu", dmu="dmu",
                 dx="dx", dy="dy", dpx="dpx", dpy="dpy",
                 wx="wx", wy="wy", wxp="wxp", wyp="wyp" }
local optvar = { dx="1", dpx="2", dy="3", dpy="4", wx="1", wy="2", wxp="1", wyp="2" }
local optlen = { alfa=2, beta=2, gama=2, disp=1, mu=1, dmu=1,
                 dx=0, dy=0, dpx=0, dpy=0, wx=0, wy=0, wxp=0, wyp=0 }
local optsep = { [("_"):byte()] = "000000", [("-"):byte()] = "", [("v"):byte()] = "" }

local function nf_pk (of)
  local f = assertf(optlst[of:match("%l+")], "invalid function '%s'", of)
  local n = optlen[f]
  local p, k = optvar[f] or of:sub(#f+1,#f+n), of:sub(#f+1+n) or "_"
  local m = assertf(optsep[k:byte()], "invalid separateur '%s'", of)
  return f, p, m..k:sub(2)
end

local function nfopt (nf, of, ki_, ko_, mt_, a0_, mt0_)
  local ar, ks = nf, ""

  if is_damap(ki_) then      -- right shifts
    a0_, ki_, ko_ = ki_, nil, nil
  elseif is_damap(ko_) then  -- right shifts
    a0_, ko_ = ko_, nil
  end

  -- build knobs monomial string
  if ki_ then ks = nf_pms(nf, ki_, ko_) end

  -- extract damap from nf
  if is_nf(nf) then ar = nf.ar or nf.a:real() end

  assert(is_damap(ar) and  ar.status == "Aset",
    "invalid argument #1 (Aset damap or normal form expected)")
  assert(is_nil(a0_) or is_damap(a0_) and a0_.status == "Aset",
    "invalid argument #3 (Aset damap expected)")
  assert(is_string(of), "invalid argument #2, function as string expected")

  local f, p, ms = nf_pk(of)
--print("of=", of, "f=", f, "p=", p, "ms=", ms, "ks=", ks)
  return optfct[f](ar, p, monomial(ms..ks), mt_ or {}, a0_, mt0_ or {})
end

gphys.optfun = nfopt

-- analyse anh, gnf, ham --

local T1, T2, T21, T22, T23, T24 = 0, 0, 0, 0, 0, 0

local function nfana_timing ()
  local T = T1+T2
  printf("time_rot =% 8.2fs [%2d%%]\n", T1 , math.floor(T1 /T*100))
  printf("time_gnf =% 8.2fs [%2d%%]\n", T2 , math.floor(T2 /T*100))
  printf("     pha =% 8.2fs [%2d%%]\n", T21, math.floor(T21/T*100))
  printf("     log =% 8.2fs [%2d%%]\n", T22, math.floor(T22/T*100))
  printf("     fld =% 8.2fs [%2d%%]\n", T23, math.floor(T23/T*100))
  printf("     gnf =% 8.2fs [%2d%%]\n", T24, math.floor(T24/T*100))
  printf("time_tot =% 8.2fs\n", T)
end

-- uncomment to print the timings at exit
!MAD.utility.atexit(nfana_timing)

--[[
FCC-ee full RDT calculation
time_rot =   40.24s [ 6%]
time_gnf =  620.11s [94%]
     pha =   88.13s [13%]
     log =  503.13s [76%]
     fld =    0.45s [ 0%]
     gnf =   28.40s [ 4%]
time_tot =  660.35s
--]]

local normal -- forward local decl

local nf_knd = {anh=1, gnf=2, ham=3, all=3}

local function nfana (nf, k_, a_)
  if is_damap(k_) and is_nil(a_) then a_, k_ = k_ end -- right shift

  local kind = nf_knd[k_]
  assert(is_nf (nf), "invalid argument #1 (normal form expected)")
  assert(is_nil(k_) or kind, "invalid argument #2 (kind expected)" )
  assert(is_nil(a_) or is_damap(a_), "invalid argument #3 (A-damap expected)")

  local t0  = os.clock()

  -- propagated normalizing form, clone current nf with new map, apply rotations
  if a_ then                                      -- normal(nfa, "close").a
    local nfa = nf:copy(a_) ; a_, nfa.m_n = nfa.m_n:set0(0), nil
    local mu1 =                 atan2(a_.x:get(3), a_.x:get(2))
    local mu2 =                 atan2(a_.y:get(5), a_.y:get(4))
    local mu3 = nf.ipt == 0 and atan2(a_.t:get(7), a_.t:get(6)) or 0

    if abs(mu1)+abs(mu2)+abs(mu3) > 0 then
      local ri = a_:same():eye()
      ri. x:set(2, cos(mu1)) ; ri. x:set(3,-sin(mu1))
      ri.px:set(2, sin(mu1)) ; ri.px:set(3, cos(mu1))
      ri. y:set(4, cos(mu2)) ; ri. y:set(5,-sin(mu2))
      ri.py:set(4, sin(mu2)) ; ri.py:set(5, cos(mu2))
      ri. t:set(6, cos(mu3)) ; ri. t:set(7,-sin(mu3))
      ri.pt:set(6, sin(mu3)) ; ri.pt:set(7, cos(mu3))
      a_ = a_*ri
    end
    nf, nfa.a = nfa, a_:cplx()
  end

  local t1 = os.clock()
  local t21, t22, t23 = t1, t1, t1

  -- GNF and HAM
  if is_nil(nf.gnf) and kind >= 2 then
    local a, c, ci, rk, nn, it, lam in nf
    local gnf, ham = table.new(32,32), table.new(32,32)
    local ng, nh, mono = 1, 1, monomial(nn)
    local g, l = ci*a*c
    t21 = os.clock()
    g, l = g:factor_map(-1)
    t22 = os.clock()
    g = g:fld2vec(true):cutord(-2) -- keep only orders 3..
    t23 = os.clock()

    for i,v in g:iter(mono) do
      local ms = mono:tostring()
      gnf[ng], gnf[ms], ng = ms, v, ng+1                            -- gnf terms

      if kind >= 3 then
        local p = 1
        for j=2,rk,2 do p = p*lam[j-1]^(mono[j-1]-mono[j]) end
        ham[nh], ham[ms], nh = ms, v*(1-p), nh+1                    -- ham terms
      end
    end
    nf.gnf, nf.ham = gnf, ham

    -- add access methods
    nf.gnfu, nf.haml = nf_gnfu, nf_haml
  end

  local t2 = os.clock()

  T1, T2 = T1+t1-t0, T2+t2-t1
  T21, T22, T23, T24 = T21+t21-t1, T22+t22-t21, T23+t23-t22, T24+t2-t23

  return nf
end

-- normal form init & copy ----------------------------------------------------o

local function nfcpy (nf, a_)
  local na = is_nil(a_)

  assert(is_nf (nf), "invalid argument #1 (normal form expected)")
  assert(na or is_damap(a_) and a_.status == 'Aset',
                     "invalid argument #2 (Aset damap expected)")
  assert(na or a_.__td == nf.a.__td,
                     "invalid argument #2 (incompatible GTPSA descriptors)")

  local cpy = {
    __id    = nf_id,

    -- data
    nn      = nf.nn,                     -- #(variables + parameters)   (values)
    nv      = nf.nv,                     -- #(variables)                (values)
    rk      = nf.rk,                     -- rank of variables           (values)
    it      = nf.it,                     -- index of t  when coasting   (values)
    ipt     = nf.ipt,                    -- index of pt when constant   (values)
    urdt    = nf.urdt,                   -- user defined rdt (optional) (shared)
    x0      = na and nf.x0  or a_:get0(),-- backup initial orbit        (shared)
    m0      = na and nf.m0  or a_:copy(),-- backup initial one-turn map (shared)
    m_n     = na and nf.m_n or a_:copy(),-- working map                 (shared)
    a       = na and nf.a   or nil,      -- normalizing map (output)    (shared)
    a_0     = na and nf.a_0 or nil,      -- map to PI basis             (shared)
    a_1     = na and nf.a_1 or nil,      -- map to CS basis             (shared)
    a_2     = na and nf.a_2 or nil,      -- map to NL basis             (shared)
    c       = nf.c ,                     -- map to AA basis             (shared)
    ci      = nf.ci,                     -- map to AA basis             (shared)
    q1_     = nf.q1_,                    -- tunes                       (values)
    q2_     = nf.q2_,                    -- tunes                       (values)
    q3_     = nf.q3_,                    -- tunes                       (values)
    lam     = nf.lam,                    -- eigentunes                  (shared)
    anh     = nf.anh,                    -- anharmonicities             (shared)
    gnf     = na and nf.gnf or nil,      -- generating functions RDTs   (shared)
    ham     = na and nf.ham or nil,      -- hamiltonian terms           (shared)

    -- methods
    q1      = nf.q1,
    q2      = nf.q2,
    q3      = nf.q3,
    dq1     = nf.dq1,
    dq2     = nf.dq2,
    dq3     = nf.dq3,
    anhx    = nf.anhx,
    anhy    = nf.anhy,
    anht    = nf.anht,
    gnfu    = nf.gnfu,
    haml    = nf.haml,
    getms   = nf.getms,
    getpms  = nf.getpms,
    copy    = nf.copy,
    optfun  = nf.optfun,
    analyse = nf.analyse,
  }

  return cpy
end

local function normal_init (m, urdt_)
  assert(is_damap(m), "invalid argument #1 (damap expected)")
  assert(mrnk[m.status] == 1 and m.status ~= 'Aset',
                      "invalid argument #1 (Xset or Mset damap expected)")
  assert(is_nil(urdt_) or is_table(urdt_), "invalid argument #2 (table expected)")

  local ndpt = not has_dpt(m)
  local ndt  = ndpt and m.t ~= nil

  -- 0 1 2  3 4    5  6  nv       nn
  -- | x px y py | t  pt | params |  6D  (nv==6 and ndpt==false -> it=0, ipt=0)
  -- | x px y py | t  pt | params |  56D (nv==6 and ndpt==true  -> it=5, ipt=6)
  -- | x px y py | pt    | params |  5D  (nv==5 and ndpt==true  -> it=0, ipt=5)
  -- | x px y py |       | params |  4D  (nv==4 and ndpt==true  -> it=0, ipt=0)

  local nf = {
    __id = nf_id,                          -- is_nf

    -- data
    nn   = m.__td.nn,                      -- #variables + #parameters
    nv   = m.__td.nv,                      -- #variables
    rk   = ndt and 4 or 6,                 -- rank of variables
    it   = ndt and 5 or 0,                 -- index of t  when coasting
    ipt  = ndt and 6 or ndpt and 5 or 0,   -- index of pt when constant
    urdt = urdt_,                          -- user defined rdt (optional)
    x0   = m:get0(),                       -- backup orbit
    m0   = m:copy(),                       -- backup original one-turn map
    m_n  = m:copy(),                       -- working map

    -- methods
    copy   = nfcpy,                        -- make a copy
    getms  = nf_ms,                        -- build monomial vars  string
    getpms = nf_pms,                       -- build monomial knobs string

    -- other data
    -- a       = nf.a,        -- set by normal[_a0, _a1, _c]
    -- a_0     = nf.a_0,      -- set by normal_a0
    -- a_1     = nf.a_1,      -- set by normal_a1
    -- a_2     = nf.a_2,      -- set by normal
    -- c       = nf.c,        -- set by normal_c
    -- ci      = nf.ci,       -- set by normal_c
    -- q1_     = nf.q1_,      -- set by normal_qs
    -- q2_     = nf.q2_,      -- set by normal_qs
    -- q3_     = nf.q3_,      -- set by normal_qs
    -- lam     = nf.lam,      -- set by normal[_a1]
    -- anh     = nf.anh,      -- set by normal
    -- gnf     = nf.gnf,      -- set by analyse
    -- ham     = nf.ham,      -- set by analyse

    -- other methods
    -- q1      = nf.q1,       -- set by normal_qs
    -- q2      = nf.q2,       -- set by normal_qs
    -- q3      = nf.q3,       -- set by normal_qs
    -- dq1     = nf.dq1,      -- set by normal
    -- dq2     = nf.dq2,      -- set by normal
    -- dq3     = nf.dq3,      -- set by normal
    -- anhx    = nf.anhx,     -- set by normal
    -- anhy    = nf.anhy,     -- set by normal
    -- anht    = nf.anht,     -- set by normal
    -- gnfu    = nf.gnfu,     -- set by analyse
    -- haml    = nf.haml,     -- set by analyse
    -- optfun  = nf.optfun,   -- set by normal
    -- analyse = nf.analyse,  -- set by normal
  }

-- io.write("nv=", nf.nv, ", np=", nf.nn-nf.nv, ", it=", nf.it, ", ipt=", nf.ipt, "\n")

  return nf
end

-- closed form (fix point) = a0^-1 * m * a0 -----------------------------------o

local function normal_a0 (nf)
  assert(is_nf(nf), "invalid argument #1 (normal form expected)")

  if not is_nil(nf.a_0) then                        -- already processed
    return nf
  end

  local nv, rk, it, ipt, m_n in nf
  local v, x = m_n:copy(), m_n:same()

  local nn, nv = nv, rk                             -- process t,pt as params

  for i=1,nv    do v[i]:set(i+1,1,-1) end           -- sub id to vars
  for i=nv+1,nn do v[i]:setvar(0,i)                 -- set t,pt params to id
                   x[i]:setvar(0,i)   end
  if it ~= 0 then  x.t :clear()       end           -- 56D coasting beam

  local a0 = v^-1 * x                               -- closing form (all orders)

  if it ~= 0 then                                   -- 56D coasting beam
    if (a0.pt - x.pt:setvar(0,ipt)):isnul() then
      a0.t:setvar(0,it)
    else
      local t1, m1 = v.x:same(), v.x:same()
      for i=2,nv,2 do                               -- make t symplectic
        x[i], x[i-1] = -a0[i-1], a0[i]              -- swap
        v[i], v[i-1] = x[i]:deriv(ipt), x[i-1]:deriv(ipt)
        t1 = t1 - m1:setvar(0,i  ) * v[i  ]         -- 1st order
                - m1:setvar(0,i-1) * v[i-1]         --  "
                - 0.5*(x[i-1]*v[i] - x[i]*v[i-1])   -- 2nd order
      end
      a0.t = t1                                     -- will make t symplectic
      if a0.t:isnul() then a0.t:setvar(0,it) end
    end
  end

  if ipt ~= 0 and m_n.pt:isnul() then               -- 5D coasting beam
    m_n.pt:setvar(0,ipt)                            --    with implicit pt (!)
  end

  for i=1,nv do a0[i]:set(i+1,1,1) end              -- add id to vars

  m_n:set0(0)                                       -- clear orbit

  nf.m_n = a0^-1 * m_n * a0                         -- go to fix point
  nf.a_0 = a0

  return nf
end

-- linear normal form = a1^-1 * a0^-1 * m * a0 * a1 ---------------------------o

local function normal_qs (nf, lam)
  local q1 = lam[1]:carg()/twopi ; if q1 < 0 then q1 = q1+1 end
  local q2 = lam[3]:carg()/twopi ; if q2 < 0 then q2 = q2+1 end
  local q3 = #lam < 5 and 0 or
             lam[5]:carg()/twopi ; if q3 < 0 then q3 = q3+1 end

  -- hook data/ add methods
  nf.lam, nf.q1_, nf.q2_, nf.q3_, nf.q1, nf.q2, nf.q3 =
     lam,    q1 ,    q2 ,    q3 , nf_q1, nf_q2, nf_q3
end

local function normal_a1 (nf)
  assert(is_nf(nf), "invalid argument #1 (normal form expected)")

  if not is_nil(nf.a_1) then      -- already processed
    return nf
  end

  local ipt, m_n in nf
  local M = m_n:get1()            -- retrieve one-turn map

  -- remove parameters
  local rg = ipt ~= 0 and r4 or r6
  M = M:getsub(rg,rg)             -- reduce M to rank

  make_stable(M)                  -- stabilise    M if needed
  make_symp  (M)                  -- symplectifiy M if needed
                                  -- eigenvalues (W) and right eigenvectors (A)
  local W, info, A = M:eigen(M:same())

  norml_eigen(A)                  -- normalize eigen system
  order_eigen(A, W)               -- order eigval and eigvec by planes
  phase_eigen(A)                  -- rephase eigen vectors to CS form

  normal_qs(nf, W)                -- add tunes

  local a1 = m_n:same():eye():set1(A)

  nf.m_n = a1^-1 * m_n * a1       -- go to Courant-Snyder basis
  nf.a_1 = a1
end

-- phasor basis = c^-1 * (a1^-1 * (a0^-1 * m * a0) * a1) * c --------o

local c_val = {[1]={0.5, 0.5; -0.5i, 0.5i}, [-1]={1, 1i; 1, -1i}}
local c_pbv = {[1]=-2i,                     [-1]=0.5i}

local function phasor (nf, inv_)
  local v, r = c_val[inv_ or 1], c_pbv[inv_ or 1]

  assert(is_nf(nf)  , "invalid argument #1 (normal form expected)")
  assert(is_table(v), "invalid argument #2 (-1 or 1 expected)")

  local ipt, m_n in nf
  local c, rk = m_n:same(0i):eye(), ipt ~= 0 and 4 or 6

  for i=2,rk,2 do -- 2,4,6,..
    c[i-1]:clear():set(i, 0, v[1]):set(i+1, 0, v[2]) -- c[1] -- clear?
    c[i  ]:clear():set(i, 0, v[3]):set(i+1, 0, v[4]) -- c[2] -- clear?
  end

  return c, r
end

gphys.phasor = phasor

local function normal_c (nf)
  assert(is_nf(nf), "invalid argument #1 (normal form expected)")

  if not is_nil(nf.c) then        -- already processed
    return nf
  end

  local c  = phasor(nf,  1)       -- get phasor
  local ci = phasor(nf, -1)       -- get phasor (inverse)

  nf.m_n = ci * nf.m_n * c        -- go to phasor basis (action-angle)
  nf.c, nf.ci = c, ci
end

-- full normal form (PTC-like) ------------------------------------------------o

function normal (m, urdt_)
  assert(is_damap(m) or is_nf(m),
         "invalid argument #1 (damap or normal form expected)")

  local ustop
  if is_string(urdt_) then
    ustop, urdt_ = urdt_, nil
  end

  -- initialization -----------------------------

  local nf = is_nf(m) and m or normal_init(m, urdt_)

  -- closed form --------------------------------

  normal_a0(nf)                    -- closed form (fix point)

  if ustop == "close" then
    nf.a = nf.m_n -- shared
    return nf
  end

  -- linear normal form -------------------------

  normal_a1(nf)                    -- linear normal form (Courant-Snyder basis)

  if ustop == "linear" or m:mord() == 1 then
    nf.a = nf.m_n -- shared
    if m:mord() == 1 then nf.m_n = nil end
    return nf
  end

  -- phasor basis & tunes -----------------------

  normal_c(nf)                     -- resonance basis (action-angle basis)

  local r1i = nf.m_n:getord(1)^-1  -- linear map (only) in phasors basis

  if is_nil(nf.lam) then           -- eigentunes (lambda)
    local lam = cvector(nf.rk)
    for i=1,nf.rk do lam[i] = r1i[i]:get(i+1) end
    normal_qs(nf, lam)
  end

  -- non-linear normal form ---------------------

  -- prepare factored Lie representation of A and N
  local nn, nv, rk, urdt, lam, m_n in nf
  local f_op, t_op = {m_n:same()}, {m_n:same()}
  local id, mono = m_n:same():eye(), monomial(nn)
  local anh, ai = table.new(32,32), 1

  -- nonlinear iterations
  for n=2,m_n:mord() do
    -- project remaining orders on resonance basis
    local n_n = (m_n * r1i):lieexppb(t_op, -1):getord(n)

    -- use directly the vector field
    local f_n, t_n = n_n:same(), n_n:same() -- fun, ker

    for k=1,nv do
      -- select/reject resonances
      for i,v in n_n[k]:iter(mono) do
        local ms = mono:tostring()
        local mt = mono:totable()

        mt[k] = mt[k]-1
        local s = 0
        for j=2,rk,2 do               -- check for resonances
          s = s + abs(mt[j]-mt[j-1])
        end

        if s ~= 0 and urdt then       -- check for user resonances
          for _,r in ipairs(urdt) do  -- {{3,0,0}, {1,2,0}, {0,3,0}, etc.}
            local rs = 0
            for j=2,rk,2 do
              rs = rs + abs(abs(mt[j]-mt[j-1]) - r[j/2])
            end
            if rs == 0 then s = 0 ; break end -- keep user resonances
          end
        end

        -- print("ms=", ms, "k=", k, "s=", s, "v=", v)
        if s ~= 0 then
          local p = 1
          for j=1,rk do p = p * lam[j]^mt[j] end
          v = v / (1-p)
          if abs(1-p) < stab_tol then
            io.stderr:write("Warn: trying to kill ", ms, " with p = ", p:tostring(), "\n")
          end
          f_n[k]:set(mono, 1, v)
        else
          t_n[k]:set(mono, 1, v)
          anh[ai], anh[ms], ai = ms, -v:imag()/twopi * mono:ordpf(nv,1,2), ai+1
        end
      end -- iter
    end -- for k

    -- save vector fields
    f_op[n], t_op[n] = f_n, t_n
    if n == m_n:mord() then break end

    m_n = (id:exppb(-f_n) * m_n):exppb(f_n)
  end -- for n

  -- the normalizing map A (nonlinear part)
  nf.a_2 = nf.c * id:lieexppb(f_op) * nf.ci

  -- the normalizing map A (full reconstruction)
  nf.a   = nf.a_0 * nf.a_1 * nf.a_2

  -- hook/clear results
  nf.m_n, nf.anh =
     nil,    anh

  -- add methods
  nf.dq1, nf.dq2, nf.dq3, nf.anhx, nf.anhy, nf.anht, nf.optfun, nf.analyse =
  nf_dq1, nf_dq2, nf_dq3, nf_anhx, nf_anhy, nf_anht,     nfopt,      nfana

  return nf
end

gphys.normal = normal

-- beta0 block conversion -----------------------------------------------------o

local ofun_tol in phystol

local function oval (x)
  return abs(x) < ofun_tol and 0 or x
end

-- convert beta0 block (optical functions) to A (normalising form)

function gphys.bet2map (bb0, map, sav_) -- TODO: move to beta0
  assert(typeid.is_beta0(bb0), "invalid argument #1 (beta0 block expected)")
  assert(       is_damap(map), "invalid argument #2 (damap expected)")

  local X   = (bb0.X or vector(6)):zeros()
  local A   = (bb0.A or matrix(6)):eye()

  -- normalization matrix A of the one-turn map R: N = A^-1 R A

  local get, set = A.get, A.set

  -- set orbit
  if bb0.x  then set(X,1,1, bb0.x ) end
  if bb0.px then set(X,2,1, bb0.px) end
  if bb0.y  then set(X,3,1, bb0.y ) end
  if bb0.py then set(X,4,1, bb0.py) end
  if bb0.t  then set(X,5,1, bb0.t ) end
  if bb0.pt then set(X,6,1, bb0.pt) end

  -- x plane

  local beta11 = bb0.beta11
  local alfa11 = bb0.alfa11
  local gama11 = bb0.gama11 or (1+alfa11^2)/beta11

  assertf(beta11 > 0, "invalid beta11=%.3fm (>0 expected)", beta11)

  local A11 = sqrt(beta11)
  local A21 = -alfa11/A11
  local A22 = sqrt(gama11 - A21^2) -- 1/A11

  set(A,1,1, A11) ; set(A,1,2,  0 ) -- Courant-Snyder form
  set(A,2,1, A21) ; set(A,2,2, A22)

  -- y plane

  local beta22 = bb0.beta22
  local alfa22 = bb0.alfa22
  local gama22 = bb0.gama22 or (1+alfa22^2)/beta22

  assertf(beta22 > 0, "invalid beta22=%.3fm (>0 expected)", beta22)

  local A33 = sqrt(beta22)
  local A43 = -alfa22/A33
  local A44 = sqrt(gama22 - A43^2) -- 1/A33

  set(A,3,3, A33) ; set(A,3,4,  0 ) -- Courant-Snyder form
  set(A,4,3, A43) ; set(A,4,4, A44)

  -- t plane

  local beta33 = bb0.beta33
  local alfa33 = bb0.alfa33
  local gama33 = bb0.gama33 or (1+alfa33^2)/beta33

  assertf(beta33 > 0, "invalid beta33=%.3fm (>0 expected)", beta33)

  local A55 = sqrt(beta33)
  local A65 = -alfa33/A55
  local A66 = sqrt(gama33 - A65^2) -- 1/A55

  set(A,5,5, A55) ; set(A,5,6,  0 ) -- Courant-Snyder form
  set(A,6,5, A65) ; set(A,6,6, A66)

  -- set dispersion

  if bb0.dx  then set(A,1,6, bb0.dx ) end
  if bb0.dpx then set(A,2,6, bb0.dpx) end
  if bb0.dy  then set(A,3,6, bb0.dy ) end
  if bb0.dpy then set(A,4,6, bb0.dpy) end

  -- backup rank

  local rnk = bb0.rank or has_dpt(A) and 6 or 4
  if sav_ then bb0.rank = rnk end

  -- sanity checks
  local serr, merr = (rnk >= 6 and A or A:getsub(r4,r4)):symperr(matrix(rnk))
  if serr > symp_tol then
    io.flush()
    warn("normalizing form A[%dx%d] built from beta0 block #%d is not symplectic, \z
          symperr=%.5e", rnk, rnk, bb0.id or 0, serr)
    A:print('A') ; merr:print('A_symperr')
    io.flush()
  end

  bb0.X, bb0.A, map.status = X, A, 'Aset'

  return map:setvar(X):set1(A)
end

-- fill beta0 block (optical functions) from A (normalising form) and W (tunes)

local pha_tol in phystol

local cnt = 0

function gphys.map2bet (map, rnk_, cpl_, bet_, dir_) -- TODO: move to beta0
  assert(is_damap(map), "invalid argument #1 (damap expected)")

  local bb0, ini
  if is_table(rnk_) then -- rnk_ is bb0
    ini = false
    bb0 = rnk_
    assert(typeid.is_beta0(bb0), "invalid beta0 block (not created from damap)")
  else
    ini = true
    bb0 = MAD.beta0 {rank = rnk_, cplg = cpl_, beta = bet_, sdir = dir_}
  end

  bb0.X = map:get0(bb0.X)
  bb0.A = map:get1(bb0.A)
  local X, A in bb0
  assert(A.nrow >= 6 and A.ncol >= 6, "invalid damap size (6D+ expected)")

  local get = A.get
  local rnk = bb0.rank or has_dpt(A) and 6 or 4

  -- update rank
  bb0.rank = rnk

  -- orbits

  bb0.x  = get(X,1,1)
  bb0.px = get(X,2,1)
  bb0.y  = get(X,3,1)
  bb0.py = get(X,4,1)
  bb0.t  = get(X,5,1)
  bb0.pt = get(X,6,1)

  -- diagonal terms

  bb0.alfa11 = oval( -(get(A,1,1) * get(A,2,1) + get(A,1,2) * get(A,2,2)) )
  bb0.beta11 = oval(   get(A,1,1)^2            + get(A,1,2)^2             )
  bb0.gama11 = oval(   get(A,2,1)^2            + get(A,2,2)^2             )

  bb0.alfa22 = oval( -(get(A,3,3) * get(A,4,3) + get(A,3,4) * get(A,4,4)) )
  bb0.beta22 = oval(   get(A,3,3)^2            + get(A,3,4)^2             )
  bb0.gama22 = oval(   get(A,4,3)^2            + get(A,4,4)^2             )


  if rnk >= 6 then
    bb0.alfa33 = oval( -(get(A,5,5) * get(A,6,5) + get(A,5,6) * get(A,6,6)) )
    bb0.beta33 = oval(   get(A,5,5)^2            + get(A,5,6)^2             )
    bb0.gama33 = oval(   get(A,6,5)^2            + get(A,6,6)^2             )
  else
    bb0.alfa33, bb0.beta33, bb0.gama33 = 0, 0, 0
  end

  -- coupling terms

  if bb0.cplg then
    bb0.alfa12 = oval( -(get(A,1,3) * get(A,2,3) + get(A,1,4) * get(A,2,4)) )
    bb0.beta12 = oval(   get(A,1,3)^2            + get(A,1,4)^2             )
    bb0.gama12 = oval(   get(A,2,3)^2            + get(A,2,4)^2             )

    bb0.alfa21 = oval( -(get(A,3,1) * get(A,4,1) + get(A,3,2) * get(A,4,2)) )
    bb0.beta21 = oval(   get(A,3,1)^2            + get(A,3,2)^2             )
    bb0.gama21 = oval(   get(A,4,1)^2            + get(A,4,2)^2             )

    if rnk >= 6 then
      bb0.alfa13 = oval( -(get(A,1,5) * get(A,2,5) + get(A,1,6) * get(A,2,6)) )
      bb0.beta13 = oval(   get(A,1,5)^2            + get(A,1,6)^2             )
      bb0.gama13 = oval(   get(A,2,5)^2            + get(A,2,6)^2             )

      bb0.alfa31 = oval( -(get(A,5,1) * get(A,6,1) + get(A,5,2) * get(A,6,2)) )
      bb0.beta31 = oval(   get(A,5,1)^2            + get(A,5,2)^2             )
      bb0.gama31 = oval(   get(A,6,1)^2            + get(A,6,2)^2             )

      bb0.alfa23 = oval( -(get(A,3,5) * get(A,4,5) + get(A,3,6) * get(A,4,6)) )
      bb0.beta23 = oval(   get(A,3,5)^2            + get(A,3,6)^2             )
      bb0.gama23 = oval(   get(A,4,5)^2            + get(A,4,6)^2             )

      bb0.alfa32 = oval( -(get(A,5,3) * get(A,6,3) + get(A,5,4) * get(A,6,4)) )
      bb0.beta32 = oval(   get(A,5,3)^2            + get(A,5,4)^2             )
      bb0.gama32 = oval(   get(A,6,3)^2            + get(A,6,4)^2             )
    else
      bb0.alfa13, bb0.beta13, bb0.gama13 = 0, 0, 0
      bb0.alfa31, bb0.beta31, bb0.gama31 = 0, 0, 0
      bb0.alfa23, bb0.beta23, bb0.gama23 = 0, 0, 0
      bb0.alfa32, bb0.beta32, bb0.gama32 = 0, 0, 0
    end
  end

  -- dispersions

  if rnk >= 6 then
    local H = A*I56*A:sympconj()
    local _h66 = 1/get(H,6,6)

    bb0.dx, bb0.dpx = oval( get(H,1,6)*_h66 ), oval( get(H,2,6)*_h66 )
    bb0.dy, bb0.dpy = oval( get(H,3,6)*_h66 ), oval( get(H,4,6)*_h66 )
  else
    bb0.dx, bb0.dpx = oval( get(A,1,6) ), oval( get(A,2,6) )
    bb0.dy, bb0.dpy = oval( get(A,3,6) ), oval( get(A,4,6) )
  end

  -- ongoing (cumulated calculation)

  if ini then
    bb0.mu1, bb0.mu1_, bb0.dmu1, bb0.dmu1_ = 0, 0, 0, 0
    bb0.mu2, bb0.mu2_, bb0.dmu2, bb0.dmu2_ = 0, 0, 0, 0
    bb0.mu3, bb0.mu3_, bb0.dmu3, bb0.dmu3_ = 0, 0, 0, 0
  else
    local sdir in bb0

    -- phase advances (local)
    local mu1_ =              oval( atan2(get(A,1,2), get(A,1,1)) / twopi )
    local mu2_ =              oval( atan2(get(A,3,4), get(A,3,3)) / twopi )
    local mu3_ = rnk >= 6 and oval( atan2(get(A,5,6), get(A,5,5)) / twopi ) or 0

    if sdir*mu1_ < 0 and abs(mu1_) > pha_tol then mu1_ = sdir+mu1_ end
    if sdir*mu2_ < 0 and abs(mu2_) > pha_tol then mu2_ = sdir+mu2_ end
    if sdir*mu3_ < 0 and abs(mu3_) > pha_tol then mu3_ =     -mu3_ end

    local dmu1_, dmu2_, dmu3_ = mu1_-bb0.mu1_, mu2_-bb0.mu2_, mu3_-bb0.mu3_

    if sdir*dmu1_ < 0 and abs(dmu1_) > pha_tol then dmu1_ = sdir+dmu1_ end
    if sdir*dmu2_ < 0 and abs(dmu2_) > pha_tol then dmu2_ = sdir+dmu2_ end
    if sdir*dmu3_ < 0 and abs(dmu3_) > pha_tol then dmu3_ =     -dmu3_ end

    -- phase advances (cumulated, backup local)
    bb0.mu1, bb0.mu1_, bb0.dmu1_  = bb0.mu1+dmu1_, mu1_, dmu1_
    bb0.mu2, bb0.mu2_, bb0.dmu2_  = bb0.mu2+dmu2_, mu2_, dmu2_
    bb0.mu3, bb0.mu3_, bb0.dmu3_  = bb0.mu3+dmu3_, mu3_, dmu3_
  end

  -- Edwards-Teng coupling formalism (Lebedev & Bogacz 2010)

  if bb0.cplg then
    local dpp1 = sqrt(1 + 2/bb0.beta*bb0.pt + bb0.pt^2)
    bb0.betx = bb0.beta11*dpp1
    bb0.bety = bb0.beta22*dpp1
    bb0.alfx = bb0.alfa11
    bb0.alfy = bb0.alfa22
    bb0.kpa  = 1

    local kx2 = bb0.beta12/bb0.beta11                                 -- eq. 4.7
    local ky2 = bb0.beta21/bb0.beta22
    local kxy = kx2*ky2

    if abs(kx2-ky2) >= stab_tol and abs(1-kxy) >= stab_tol then -- eq. 4.8 & 4.9
      local kx, ky = sqrt(kx2), sqrt(ky2)
      local ax = (bb0.alfa11*kx - bb0.alfa12/kx);                     -- eq. 4.7
      local ay = (bb0.alfa22*ky - bb0.alfa21/ky);
      local ku = kxy*(1+(ax*ax-ay*ay)/(kx2-ky2)*(1-kxy))              -- eq. 4.8
      local u = -kxy/(1-kxy)
      local s = 0
      if ku >= stab_tol then
        local su = sqrt(ku)
        s = kxy <= su and +1 or -1
        u = u + s * su/(1-kxy)                                        -- eq. 4.8
      end
      local kpa = 1-u

      bb0.betx = bb0.betx/kpa                                        -- eq. 7.16
      bb0.bety = bb0.bety/kpa
      bb0.alfx = bb0.alfx/kpa
      bb0.alfy = bb0.alfy/kpa
      bb0.kpa  = kpa

      local bx  = kx*kpa + u/kx                                      -- eq. 4.10
      local by  = ky*kpa + u/ky
      local cx  = kx*kpa - u/kx
      local cy  = ky*kpa - u/ky
      local evp = (ax + 1i*bx) / (ay - 1i*by)
      local evm = (ax + 1i*cx) / (ay + 1i*cy)
      local ev1 = sqrt(evp*evm)                                      -- eq. 4.11
      local ev2 = sqrt(evp/evm)

      local swp = ""
      cnt = cnt + 1

--    local a1  = rad2deg*ev1:carg()
--    local a2  = rad2deg*ev2:carg()

      if sign(ev1.im) ~= sign(ev2.im) then                           -- eq. 7.12
        -- see discussion in paragraph after eq. 4.11
        if ev1.re < 0 then ev1 = -ev1 ; swp = "[1]" else ev2 = -ev2 ; swp = "[2]" end
      end

      bb0.r11  =  sqrt(bb0.beta22/bb0.beta12) * (u*ev2.re + bb0.alfa12*ev2.im)/kpa
      bb0.r22  = -sqrt(bb0.beta11/bb0.beta21) * (u*ev1.re + bb0.alfa21*ev1.im)/kpa
      bb0.r12  =  sqrt(bb0.beta11*bb0.beta21) * ev1.im/kpa
      bb0.r21  = (ev2.re*(bb0.alfa12*kpa - bb0.alfa22*u) -
                  ev2.im*(bb0.alfa12*bb0.alfa22 + kpa*u)) / (kpa*sqrt(bb0.beta12*bb0.beta22))

--    local b1  = rad2deg*ev1:carg()
--    local b2  = rad2deg*ev2:carg()

--    printf("%-3d, %d, %- .5e, %- .5f, %- .5f, %- .5f, %- .5f, %- .5f, % 7.2f, % 7.2f %s\n",
--            cnt, s, u, bb0.r12, ev1.re, ev1.im, ev2.re, ev2.im, a1-a2, b1-b2, swp)

      local sbetx, sbety = sqrt(bb0.betx), sqrt(bb0.bety)
      local    r  = matrix(2):fill{bb0.r22, -bb0.r12, -bb0.r21, bb0.r11} -- -S*R*S
      local    ga = matrix(2):fill{1/sbetx, 0,  bb0.alfx/sbetx,   sbetx}
      local   _gb = matrix(2):fill{  sbety, 0, -bb0.alfy/sbety, 1/sbety} -- gb^-1
      local     c = r/sqrt(1+r:det())              -- eq. 16
      local  cbar = ga * c * _gb                   -- eq. 5
      local    cb = 0.25/sqrt(1-cbar:det())*cbar   -- eq. 9 & 10

      bb0.f1010 = -cb:get(1,2)-cb:get(2,1) + 1i*(cb:get(1,1)-cb:get(2,2))
      bb0.f1001 =  cb:get(1,2)-cb:get(2,1) + 1i*(cb:get(1,1)+cb:get(2,2))
    else
      bb0.r11   = 0
      bb0.r22   = 0
      bb0.r12   = 0
      bb0.r21   = 0
      bb0.f1010 = 0
      bb0.f1001 = 0
    end
  end

  return bb0
end

function gphys.chr2bet (bb0, fdp, dpt) -- TODO: move to beta0?
  assert(typeid.is_beta0(bb0), "invalid argument #1 (beta0 block expected)")
  assert(typeid.is_beta0(fdp), "invalid argument #2 (beta0 block expected)")
  assert(     is_nonzero(dpt), "invalid argument #3 (number ~= 0 expected expected)")

  -- phase advances vs dpt

  local dmu1_ = (fdp.dmu1_ - bb0.dmu1_) / dpt
  local dmu2_ = (fdp.dmu2_ - bb0.dmu2_) / dpt
  local dmu3_ = (fdp.dmu3_ - bb0.dmu3_) / dpt

  bb0.dmu1 = bb0.dmu1 + dmu1_
  bb0.dmu2 = bb0.dmu2 + dmu2_
  bb0.dmu3 = bb0.dmu3 + dmu3_

  -- dispersions from orbit

  bb0.Dx  = (fdp.x  - bb0.x ) / dpt
  bb0.Dy  = (fdp.y  - bb0.y ) / dpt
  bb0.Dpx = (fdp.px - bb0.px) / dpt
  bb0.Dpy = (fdp.py - bb0.py) / dpt

  -- dispersions vs dpt

  bb0.ddx  = 0.5*(fdp.dx  - bb0.dx ) / dpt
  bb0.ddy  = 0.5*(fdp.dy  - bb0.dy ) / dpt
  bb0.ddpx = 0.5*(fdp.dpx - bb0.dpx) / dpt
  bb0.ddpy = 0.5*(fdp.dpy - bb0.dpy) / dpt

  -- chromatic functions

  if bb0.beta11 then
    assertf(bb0.beta11 > 0, "invalid beta11=%.3fm (>0 expected)", bb0.beta11)

    local dbetx = (fdp.beta11 - bb0.beta11) / dpt
    local dalfx = (fdp.alfa11 - bb0.alfa11) / dpt
    local bx = dbetx / bb0.beta11
    local ax = dalfx - bb0.alfa11*bx

    bb0.wx = sqrt(ax^2 + bx^2)
    if bb0.wx > 1e-12 then
      local phix = atan2(ax, bx)
      bb0.phix_  = rangle(phix, bb0.phix_ or phix)
      bb0.phix   = bb0.phix_ / twopi
    end
  end

  if bb0.beta22 then
    assertf(bb0.beta22 > 0, "invalid beta22=%.3fm (>0 expected)", bb0.beta22)

    local dbety = (fdp.beta22 - bb0.beta22) / dpt
    local dalfy = (fdp.alfa22 - bb0.alfa22) / dpt
    local by = dbety / bb0.beta22
    local ay = dalfy - bb0.alfa22*by

    bb0.wy = sqrt(ay^2 + by^2)
    if bb0.wy > 1e-12 then
      local phiy = atan2(ay, by)
      bb0.phiy_  = rangle(phiy, bb0.phiy_ or phiy)
      bb0.phiy   = bb0.phiy_ / twopi
    end
  end
end

-- Method is implemented from SLAC-Pub-1193 where integration is
-- done explicitly and includes effect of poleface rotations

function gphys.syn2bet(bb0, mflw, elm) -- TODO: move to beta0?
  assert(typeid.is_beta0(bb0), "invalid argument #1 (beta0 block expected)")
  local el, eh, e1, e2, nmul, knl, tdir, beam in mflw

  if el == 0 or (eh == 0 and (nmul < 2 or knl[2] == 0)) then return end

  local debug in option
  local synch_1, synch_2, synch_3, synch_4, synch_5, synch_6, synch_8 =
              0,       0,       0,       0,       0,       0,       0

  if bb0.synch_1 == nil then
    bb0.synch_1, bb0.synch_2, bb0.synch_3, bb0.synch_4,
    bb0.synch_5, bb0.synch_6, bb0.synch_8 = 0, 0, 0, 0, 0, 0, 0
  end

  local k1   = knl[2]/el*tdir
  local te1  = tan(e1 or 0)
  local beta = beam.beta
  local dx   = bb0.dx *beta
  local dpx  = bb0.dpx*beta + dx*eh*te1

  -- global gradient combining weak focusing and dipole gradient
  -- k2 can be positive or negative and k can be real or imaginary

  if debug > 0 then
    print('Synchrotron integrals at exit of element ', elm.name, elm.kind)
    print('Input:  eh = ', eh, 'k1 = ', k1, 'e1 =', e1, 'e2 = ', e2, 'blen = ', el)
    print('        betxi = ', bb0.beta11, 'alfxi = ', bb0.alfa11, 'dxi = ', dx, 'dpxi = ', dpx)
  end

  -- propagation of dispersion at exit
  if eh ~= 0 then -- bend contribution
    local betx = bb0.beta11
    local alfx = bb0.alfa11 - betx*eh*te1
    local gamx = (1 + alfx^2) / betx

    local k2 = eh^2 + 2*k1
    local k  = sqrt(k2+0i)
    local kl = k*el
    local ckl, skl = cos(kl), sin(kl)
    local eh2, eh3 = eh^2, eh^3
    local kl2, kl3 = kl^2, kl^3
    local dx2      = real(dx*ckl + dpx*skl/k + eh*(1-ckl)/k2)
    local dispavg  = real(dx*skl/kl + dpx*(1-ckl)/(k*kl) + eh*(kl-skl)/(k2*kl))
    local curlyavg = real( gamx*dx^2 + 2*alfx*dx*dpx + betx*dpx^2
              + 2*eh*el*(-(gamx*dx + alfx*dpx)*(kl-skl)/(kl2*k)
                         +(alfx*dx + betx*dpx)*(1 -ckl)/(kl2))
            + (eh*el)^2*(  gamx*(3*kl - 4*skl + skl*ckl)/(2*k2*kl3)
                         - alfx*(1 -ckl)^2  /(k*kl3)
                         + betx*(kl-ckl*skl)/(2*kl3)) )

    synch_1 = dispavg*eh*el
    synch_2 = eh2*el
    synch_3 = abs(eh3)*el
    synch_4 = dispavg*eh*(eh2 + 2*k1)*el - eh2*(dx*te1 + dx2*tan(e2 or 0))
    synch_5 = curlyavg*abs(eh3)*el

    bb0.synch_1 = bb0.synch_1 + synch_1
    bb0.synch_2 = bb0.synch_2 + synch_2
    bb0.synch_3 = bb0.synch_3 + synch_3
    bb0.synch_4 = bb0.synch_4 + synch_4
    bb0.synch_5 = bb0.synch_5 + synch_5

    if debug > 1 then
      print(' --> ')
      print('        k2 = ', k2, '  k = ', k, 'k*l = ', kl)
      print('        alfx = ', alfx, 'dpx = ', dpx, 'gamx = ', gamx, 'dx2 = ', dx2)
      print('        dispaverage = ', dispavg, 'curlyhaverage = ', curlyavg)
    end

  elseif k1 ~= 0 then -- quad contribution (exclusive)
    local sk1 = sqrt(k1+0i)
    local u0x = real((1+sin(2*sk1*el)/(2*sk1*el))/ 2)
    local u2x = real((1-sin(2*sk1*el)/(2*sk1*el))/(2*k1))
    local u1x = real(sin(sk1*el)^2)/(k1*el)
    local dx2 = real(cos(sk1*el)*dx + dpx/sk1*sin(sk1*el))
    local dispavg = (dx+dx2)/2
    local betxavg = bb0.beta11*u0x - bb0.alfa11*u1x + bb0.gama11*u2x

    synch_6 =  k1^2*betxavg   *el
    synch_8 = (k1  *dispavg)^2*el

    bb0.synch_6 = bb0.synch_6 + synch_6
    bb0.synch_8 = bb0.synch_8 + synch_8

    if debug > 1 then
      print(' --> ')
      print('        u0x = ', u0x, 'u1x = ', u1x, 'u2x = ', u2x, 'dx2 = ', dx2)
      print('        dispaverage = ', dispavg, 'betxavg = ', betxavg)
    end
  end

  if debug > 0 then
    print('Contributions to Radiation Integrals:',
           synch_1, synch_2, synch_3, synch_4, synch_5, synch_6, synch_8)
    print('')
  end
end

-- beam size extraction -------------------------------------------------------o

--[[
  Compute Eq. 7 from paper
  R. Tomas, "Nonlinear optimization of beam lines", PhysRev. Accel&Beams, 2006

  Eq. 7 assumes centered Gaussians distributions in all dimensions but in z,
  where it needs to be centered rectangular. The twiss parameters at the start
  must satisfy zero alfax, alfay, Dx, Dpx, Dy, Dpy. This yields the typical
  mistake to apply Eq. 7 without satisfying this...
--]]

local function is_even (m)
  for k=1,#m do if m[k]%2 ~= 0 then return false end end
  return true
end

function gphys.beamsize(x, sig)
  assert(is_tpsa(x), "invalid argument #1 (real TPSA expected)")
  assert(is_indexable(sig) and #sig >= 5,
                     "invalid argument #2 (iterable with 5+ values expected")
  local nv, xs = x:nv(), 0
  local mi, mj, mm = monomial(nv), monomial(nv), monomial(nv)

  for i,xi in x:iter(mi)   do
  for j,xj in x:iter(mj,i) do
    if mj >= mi and is_even(mi:add(mj,mm)) then
      local sk, xx = 0, (i == j and 1 or 2)*xi*xj
      for k=1,4 do
        xx = xx * sig[k]^mm[k] * tgamma((1+mm[k])/2)
        sk = sk + mm[k]
      end
      xx = xx * sig[5]^mm[6] * 2^(sk/2-mm[6]) / ((1+mm[6])*pi^2)
      xs = xs + xx
    end
  end end

  return sqrt(xs)
end

-- env ------------------------------------------------------------------------o

gphys = wrestrict(setmetatable(gphys, {__tostring := "MAD.gphys"}))

-- end ------------------------------------------------------------------------o
return { gphys = gphys }
